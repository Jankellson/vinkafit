---
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  activeNav?: string;
  minimalNav?: boolean;
  noNav?: boolean;
  noFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  type,
  jsonLd,
  noindex,
  activeNav,
  minimalNav,
  noNav,
  noFooter,
} = Astro.props;

const CF_BEACON_TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
---

<!DOCTYPE html>
<html lang="lv">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      type={type}
      jsonLd={jsonLd}
      noindex={noindex}
    />

    {/* Cloudflare Web Analytics — cookiju nelieto, tāpēc nav vajadzīga piekrišana. */}
    {CF_BEACON_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_BEACON_TOKEN}"}`}
      ></script>
    )}

    {/* Microsoft Clarity — tikai ja CLARITY_ID uzstādīts */}
    {CLARITY_ID && CLARITY_ID !== 'your_clarity_id_here' && (
      <script define:vars={{ CLARITY_ID }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", CLARITY_ID);
      </script>
    )}

    <ClientRouter />
  </head>
  <body>
    {!noNav && !minimalNav && <Header activeNav={activeNav} />}
    {minimalNav && (
      <header class="nav">
        <div class="wrap nav-inner">
          <a href="/" class="logo" aria-label="Ieva Jēkabsone — sākumlapa">
            <span class="logo-mark">Ieva Jēkabsone</span>
            <span class="logo-sub">Uztura konsultante · LV</span>
          </a>
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
    {!noFooter && <Footer />}

    <script>
      function initReveal() {
        if (!('IntersectionObserver' in window)) return;
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('main section, .article-body > *').forEach((el) => {
          el.classList.add('reveal');
          io.observe(el);
        });
      }
      document.addEventListener('astro:page-load', initReveal);

      // Ceļvedis (bezmaksas lead magnet) forma sākumlapā un /start izmanto Systeme.io
      // iegulto skriptu, kas balstās uz `document.currentScript` — tas strādā TIKAI pilnas
      // lapas ielādes laikā. Astro ClientRouter (SPA pārejas) skriptu ievieto no jauna
      // dinamiski, kur `currentScript` vairs nav uzticams — forma klusi neparādās (arī
      // pārlūka atpakaļ/uz priekšu pogas iet caur SPA pāreju, tāpēc labo lifecycle
      // notikuma līmenī, ne tikai klikšķu klausītājā). Tāpēc navigācija UZ "/" vai "/start"
      // vienmēr iet caur pilnu pārlādi.
      const RELOAD_PATHS = new Set(['/', '/start']);
      document.addEventListener('astro:before-preparation', (event) => {
        if (RELOAD_PATHS.has(event.to.pathname)) {
          event.preventDefault();
          window.location.href = event.to.href;
        }
      });
    </script>
  </body>
</html>
