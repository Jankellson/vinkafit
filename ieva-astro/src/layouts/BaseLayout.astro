---
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  activeNav?: string;
  minimalNav?: boolean;
  noNav?: boolean;
  noFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  type,
  jsonLd,
  noindex,
  activeNav,
  minimalNav,
  noNav,
  noFooter,
} = Astro.props;

// Measurement ID nav slepens; fallback nodrošina, ka Pages deploy sāk vākt datus
// arī tad, ja PUBLIC_GA_MEASUREMENT_ID vēl nav ievadīts Cloudflare panelī.
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-807WDRDGZP';
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
---

<!DOCTYPE html>
<html lang="lv">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      type={type}
      jsonLd={jsonLd}
      noindex={noindex}
    />

    {/* Google Analytics 4 — ar Consent Mode. gtag.js skripts (70+ KiB) ielādējas TIKAI
        tad, kad lietotājs jau piekritis (localStorage) vai piekrīt tagad (skat. zemāk
        cookie banera skriptu) — nevis visiem apmeklētājiem uzreiz, kā bija iepriekš. */}
    {GA_ID && GA_ID !== 'G-XXXXXXXXXX' && (
      <script define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('consent', 'default', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          wait_for_update: 500,
        });
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true });

        window.__loadGtagScript = function () {
          if (document.getElementById('gtag-script')) return;
          const s = document.createElement('script');
          s.id = 'gtag-script';
          s.async = true;
          s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          document.head.appendChild(s);
        };
      </script>
    )}

    {/* Microsoft Clarity — tikai ja CLARITY_ID uzstādīts */}
    {CLARITY_ID && CLARITY_ID !== 'your_clarity_id_here' && (
      <script define:vars={{ CLARITY_ID }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", CLARITY_ID);
      </script>
    )}

    <ClientRouter />
  </head>
  <body>
    {!noNav && !minimalNav && <Header activeNav={activeNav} />}
    {minimalNav && (
      <header class="nav">
        <div class="wrap nav-inner">
          <a href="/" class="logo" aria-label="Ieva Jēkabsone — sākumlapa">
            <span class="logo-mark">Ieva Jēkabsone</span>
            <span class="logo-sub">Uztura konsultante · LV</span>
          </a>
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
    {!noFooter && <Footer />}

    <aside id="cookieConsent" class="cookie-banner" aria-label="Sīkfailu izvēle" role="region" aria-live="polite" hidden>
      <p>
        Izmantoju analītiskos sīkfailus, lai saprastu, kā mājaslapa tiek izmantota un to uzlabotu.
        <a href="/privatums">Vairāk privātuma politikā</a>.
      </p>
      <div class="cookie-actions">
        <button class="cookie-decline" type="button" data-cookie-choice="reject">Noraidīt</button>
        <button class="cookie-accept" type="button" data-cookie-choice="accept">Piekrītu</button>
      </div>
    </aside>

    <script>
      function initReveal() {
        if (!('IntersectionObserver' in window)) return;
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('main section, .article-body > *').forEach((el) => {
          el.classList.add('reveal');
          io.observe(el);
        });
      }
      document.addEventListener('astro:page-load', initReveal);

      const consentKey = 'ieva-cookie-consent-v1';
      const banner = document.getElementById('cookieConsent');
      const updateConsent = (choice: 'granted' | 'denied') => {
        window.gtag?.('consent', 'update', {
          analytics_storage: choice,
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      };
      const savedConsent = localStorage.getItem(consentKey);
      if (savedConsent === 'accepted') {
        updateConsent('granted');
        window.__loadGtagScript?.();
      }
      if (!savedConsent && banner) {
        banner.hidden = false;
        requestAnimationFrame(() => banner.classList.add('is-visible'));
      }
      banner?.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-cookie-choice]');
        if (!button) return;
        const accepted = button.dataset.cookieChoice === 'accept';
        localStorage.setItem(consentKey, accepted ? 'accepted' : 'rejected');
        updateConsent(accepted ? 'granted' : 'denied');
        if (accepted) window.__loadGtagScript?.();
        banner.classList.remove('is-visible');
        window.setTimeout(() => { banner.hidden = true; }, 350);
      });

      document.addEventListener('click', (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
        if (!link) return;
        const url = new URL(link.href, window.location.href);
        if (url.hostname === 'pirkt.ievajekabsone.lv') {
          window.gtag?.('event', 'checkout_link_clicked', {
            link_text: link.textContent?.trim().slice(0, 100) || 'checkout',
            page_path: window.location.pathname,
          });
        }
      });
    </script>
  </body>
</html>
