---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

interface NormalPost {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  image?: string;
  imageAlt?: string;
}

const merged: NormalPost[] = (await getCollection('blog', ({ data }) => !data.draft))
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    description: p.data.description,
    pubDate: new Date(p.data.pubDate),
    category: p.data.category ?? '',
    image: p.data.image,
    imageAlt: p.data.imageAlt ?? p.data.title,
  }))
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString('lv-LV', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Ievas Jēkabsones blogs",
  "url": "https://ievajekabsone.lv/blog",
  "description": "Praktiski raksti par uzturu, metabolismu un veselību.",
  "author": { "@type": "Person", "@id": "https://ievajekabsone.lv/#ieva" },
  "inLanguage": "lv",
  "blogPost": merged.map((p) => ({
    "@type": "BlogPosting",
    "headline": p.title,
    "description": p.description,
    "datePublished": p.pubDate.toISOString(),
    "url": `https://ievajekabsone.lv/blog/${p.slug}`,
    "author": { "@type": "Person", "@id": "https://ievajekabsone.lv/#ieva" }
  }))
};
---

<BaseLayout
  title="Blogs — Uztura zinātne bez žargona | Ieva Jēkabsone"
  description="Praktiski raksti par uzturu, metabolismu un veselību no ITEC sertificētas uztura konsultantes Ievas Jēkabsones."
  canonical="https://ievajekabsone.lv/blog"
  jsonLd={jsonLd}
  activeNav="blog"
>

  <Breadcrumbs items={[
    { label: 'Sākums', href: '/' },
    { label: 'Blogs' }
  ]} />

  <section class="page-hero">
    <div class="wrap blog-hero-grid">
      <div>
        <div class="eyebrow">Blogs</div>
        <h1>Uztura zinātne <em>bez žargona.</em></h1>
        <p class="lede">
          Praktiski raksti par to, kā ēšana ietekmē tavu enerģiju, svaru un pašsajūtu.
          Bez dietoloģijas diktāta — ar bioloģijas palīdzību.
        </p>
      </div>

      <figure class="side-photo" style="--ar: 3/4; --obj: center 30%; margin-top:0;">
        <img
          src="/assets/images/ieva-jekabsone-sabalansets-pusdienu-skivis-virtuve.webp"
          alt="Ieva Jēkabsone virtuvē pasniedz sabalansētas pusdienas ar lasi, dārzeņiem un kvinoju — praktiski raksti par ikdienas ēšanas situācijām"
          width="1023" height="1537" loading="eager"
        />
      </figure>
    </div>
  </section>

  <section class="related" style="background: var(--cream);">
    <div class="wrap">
      {merged.length === 0 ? (
        <div style="text-align:center; padding: 80px 0;">
          <p style="font-family: var(--serif); font-style: italic; font-size: 24px; color: var(--ink-soft);">
            Raksti drīz parādīsies.
          </p>
          <a href="/" class="btn btn-ghost" style="margin-top: 32px;">Atpakaļ uz sākumu</a>
        </div>
      ) : (
        <div class="related-grid">
          {merged.map(post => (
            <a href={`/blog/${post.slug}`} class="post-card">
              {post.image && (
                <div class="thumb">
                  <img src={post.image} alt={post.imageAlt ?? post.title} loading="lazy" />
                </div>
              )}
              <div class="body">
                <span class="cat">{post.category}</span>
                <h3>{post.title}</h3>
                <p>{post.description}</p>
                <span class="read">
                  {formatDate(post.pubDate)} →
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Lead magnet CTA -->
  <section class="final">
    <div class="wrap final-inner">
      <span class="script">Sāc šeit</span>
      <h2>Bezmaksas ceļvedis — <em>5 uztura kļūdas.</em></h2>
      <p>8 minūtes lasīšanai. Nosūtīšu tieši uz tavu e-pastu.</p>
      <div class="final-ctas">
        <a href="/#start" class="btn btn-primary">Saņemt ceļvedi <span class="arrow">→</span></a>
        <a href="/kontakti" class="btn btn-ghost">Piesakies konsultācijai</a>
      </div>
    </div>
  </section>

</BaseLayout>
