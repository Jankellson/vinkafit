---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "@id": "https://ievajekabsone.lv/#ieva",
    "name": "Ieva Jēkabsone",
    "givenName": "Ieva",
    "familyName": "Jēkabsone",
    "jobTitle": "Uztura konsultante",
    "description": "ITEC sertificēta uztura konsultante. Individuāli uztura plāni un asinsanalīžu rādītāju izvērtēšana uztura un dzīvesveida kontekstā.",
    "url": "https://ievajekabsone.lv/",
    "email": "info@ievajekabsone.lv",
    "knowsLanguage": ["lv", "ru", "en"],
    "workLocation": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Rīga",
        "addressCountry": "LV"
      }
    },
    "hasCredential": [
      {"@type": "EducationalOccupationalCredential", "name": "ITEC starptautiski atzīts sertifikāts nutrioloģijā"},
      {"@type": "EducationalOccupationalCredential", "name": "Specializācija: uzturs un hormoni"},
      {"@type": "EducationalOccupationalCredential", "name": "Specializācija: zarnu mikrobioms un uzturs"},
      {"@type": "EducationalOccupationalCredential", "name": "Asinsanalīžu rādītāju izvērtēšana uztura un dzīvesveida kontekstā"},
      {"@type": "EducationalOccupationalCredential", "name": "C kategorijas fitnesa trenera sertifikāts (LTTC)"}
    ],
    "sameAs": [
      "https://www.instagram.com/ieva.jekabsone/",
      "https://www.facebook.com/profile.php?id=100089137514285",
      "https://www.tiktok.com/@ieva.jekabson"
    ]
  }
};
---

<BaseLayout
  title="Par mani — Ieva Jēkabsone, uztura konsultante"
  description="Ieva Jēkabsone — ITEC sertificēta uztura konsultante. Individuāla pieeja uzturam, septiņi sertifikāti. Konsultācijas tiešsaistē visā Latvijā un klātienē Rīgā."
  canonical="https://ievajekabsone.lv/par-mani"
  jsonLd={jsonLd}
  activeNav="par-mani"
>


  <!-- PAGE HERO -->
  <section class="phero">
    <div class="wrap phero-grid">

      <div class="phero-text">
        <div class="eyebrow">Par mani</div>
        <h1>Ieva Jēkabsone — <em>uztura konsultante.</em></h1>
        <p class="lede">
          Šajā lapā pastāstīšu par sevi, savu pieredzi un pieeju.
        </p>

        <ul class="phero-facts">
          <li><strong>ITEC</strong><span>starptautiski atzīts sertifikāts nutrioloģijā</span></li>
          <li><strong>50+</strong><span>klienti ar individuāliem uztura plāniem</span></li>
          <li><strong>6</strong><span>sertifikāti — nutrioloģija, hormoni, mikrobioms, analīzes, fitness</span></li>
        </ul>
      </div>

      <figure class="phero-photo phero-photo--cutout">
        <img
          src="/assets/images/ieva-consultant.webp"
          alt="Ieva Jēkabsone, ITEC sertificēta uztura konsultante — individuāli uztura plāni tiešsaistē latviešu un krievu valodā"
          width="1920" height="1920" loading="eager"
        />
        <figcaption><span class="script">Ieva</span> Individuāls plāns, ne šablons.</figcaption>
      </figure>

    </div>
  </section>

  <!-- EMPATHY -->
  <section class="about-empathy">
    <div class="wrap">
      <div class="empathy-top">
        <div class="section-head">
          <div class="eyebrow">Pieņemu, ka</div>
          <h2 class="section-title" style="margin-top:20px;">Tu šo lapu atvēri <em>kāda iemesla dēļ.</em></h2>
          <p class="lede" style="margin-top:24px;">
            Pirms stāstu, kāda uztura konsultante esmu — pieņemu, ka kaut kas no šī tev ir pazīstams.
          </p>
        </div>

        <figure class="side-photo" style="--ar: 1/1; --obj: center 16%; margin-top:0;">
          <img
            src="/assets/images/ieva-pastaiga-svaiga-gaisa.webp"
            alt="Ieva Jēkabsone pastaigā svaigā gaisā ar ūdens pudeli — uztura konsultante, kuras darbs sākas ar cilvēka ikdienu, ne ar gatavu ēdienkarti"
            width="895" height="1758" loading="lazy"
          />
        </figure>
      </div>

      <ul class="empathy-list">
        <li>
          <span class="empathy-num">/01</span>
          <p><strong>Esi mēģinājis vairākas reizes</strong> — un rezultāts pazūd, tiklīdz beidz sekot plānam.</p>
        </li>
        <li>
          <span class="empathy-num">/02</span>
          <p><strong>Nav skaidrs, kam ticēt</strong> — informācijas ir daudz, bet neviens nepaskaidro, kas tieši ir pareizi tavā situācijā.</p>
        </li>
        <li>
          <span class="empathy-num">/03</span>
          <p><strong>Jūti, ka kaut kas mainās</strong> — enerģija krīt, svars stāv uz vietas — bet asinsanalīzes rāda, ka viss ir normas robežās.</p>
        </li>
        <li>
          <span class="empathy-num">/04</span>
          <p><strong>Negribi vēl vienu PDF failu.</strong> Gribi kādu, kas paskatās tieši uz tavu situāciju.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- INTRO / PORTRAIT -->
  <section class="about-intro">
    <div class="wrap">
      <div class="about-intro-grid">

        <div class="figure frame photo" style="--obj: center 15%;">
          <div class="corner-marks"></div>
          <img src="/assets/images/ieva-jekabsone-sabalansets-pusdienu-skivis-virtuve.webp" alt="Ieva Jēkabsone virtuvē ar sabalansētu pusdienu šķīvi — uztura konsultante, kuras darbs sākas ar jautājumiem par tavu ikdienu, ne ar gatavu ēdienkarti" loading="lazy" />
        </div>

        <div>
          <div class="eyebrow" style="margin-bottom:24px;">Iepazīsimies</div>
          <p class="pullquote">
            "Es neiesaku diētas. <em>Es iemācu ēst veselīgi.</em>"
          </p>

          <p>
            Mans darbs nesākas ar ēdienkarti. Tas sākas ar jautājumiem par tevi —
            kāds ir tavs dienas režīms, kādas diētas jau ir mēģinātas, kāda ir tava
            pašsajūta un kādi ir tavi mērķi.
          </p>

          <p>
            Strādāju ar ļoti dažādiem cilvēkiem. Manā darbā galvenais ir
            <strong>plāns, kas pielāgojas tavai ikdienai</strong>, ne otrādi, un
            <strong>asinsanalīžu rādītāju izvērtēšana uztura un dzīvesveida kontekstā</strong>.
          </p>

          <p>
            Man svarīgs ir viens princips: <em>mērķis ir, lai tu iemācītos veselīgu uzturu
            iekļaut savā ikdienā bez uztura speciālista palīdzības.</em>
            Es nemācu diētu no galvas — es mācu saprast savu ķermeni.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- METHOD -->
  <section class="method">
    <div class="wrap">
      <div class="section-head" style="max-width:760px;">
        <div class="eyebrow">Process</div>
        <h2 class="section-title" style="margin-top:20px;">Kā es <em>strādāju.</em></h2>
        <p class="lede" style="margin-top:20px;">
          Bez šabloniem un gatavām tabulām, bet ar pieciem konkrētiem soļiem,
          kas atkārtojas ar katru klientu.
        </p>
      </div>

      <ol class="method-list">
        <li>
          <div class="num">
            <img class="bicon" src="/assets/images/ieva-uztura-personiga-saruna-ikona.webp" alt="Divi runas burbuļi ar auga lapu — pirmā saruna par tavu miegu, stresu un ikdienas ritmu" width="200" height="200" loading="lazy" />
            <span>01</span>
          </div>
          <div>
            <h3>Sākam ar tavu situāciju</h3>
            <p>Pirmajā sarunā jautāju par miegu, stresu, ikdienas ritmu, iepriekšējo pieredzi ar diētām un attieksmi pret ēdienu. Bez šī konteksta jebkurš plāns ir minējums.</p>
          </div>
        </li>
        <li>
          <div class="num">
            <img class="bicon" src="/assets/images/ieva-uztura-asinsanalizu-konteksts-ikona.webp" alt="Asinsanalīžu mēģene ar auga zariņu — laboratorijas rādītāji uztura un dzīvesveida kontekstā" width="200" height="200" loading="lazy" />
            <span>02</span>
          </div>
          <div>
            <h3>Ja ir analīzes — apskatām arī tās</h3>
            <p>Programmās pārrunājam, kā uzturs un ikdienas paradumi var būt saistīti ar taviem laboratorijas rādītājiem. To izmantoju, lai noteiktu plāna prioritātes. Diagnozes nenosaku un neārstēju — tas ir ārsta darbs.</p>
          </div>
        </li>
        <li>
          <div class="num">
            <img class="bicon" src="/assets/images/ieva-personigais-uztura-plans-ikona.webp" alt="Atvērta grāmata ar atzīmētu sarakstu un auga zaru — plāns, kas veidots pēc tavas ikdienas, darba un budžeta" width="200" height="200" loading="lazy" />
            <span>03</span>
          </div>
          <div>
            <h3>Plāns, kas pielāgojas tavai dzīvei</h3>
            <p>Tev nav jāpielāgojas manai metodei. Plānu veidojam tā, lai tas der tavam darbam, ģimenei, budžetam un gaumei. Tāpēc tas paliek arī pēc tam, kad sadarbība beigusies.</p>
          </div>
        </li>
        <li>
          <div class="num">
            <img class="bicon" src="/assets/images/ieva-uztura-veseligi-paradumi-lapas-ikona.webp" alt="Lapa ar izaugušu sakni — katram ieteikumam ir pamatojums, tāpēc paradums turpina augt pats" width="200" height="200" loading="lazy" />
            <span>04</span>
          </div>
          <div>
            <h3>Katram ieteikumam ir pamatojums</h3>
            <p>Katram ieteikumam pasaku pamatojumu. Pēc mēneša zini, kā sabalansēt savas ēdienreizes. Tā rodas patstāvība.</p>
          </div>
        </li>
        <li>
          <div class="num">
            <img class="bicon" src="/assets/images/ieva-uztura-konsultacijas-atbalsts-ikona.webp" alt="Sirds auga vainagā — regulārs atbalsts reizi nedēļā, kas dod drošību, nepadarot tevi atkarīgu no konsultanta" width="200" height="200" loading="lazy" />
            <span>05</span>
          </div>
          <div>
            <h3>Atbalsts ir regulārs, ne nepārtraukts</h3>
            <p>Reizi nedēļā vari sagatavot savus novērojumus un līdz trim jautājumiem — es uz tiem atbildu rakstiski vai balss ziņā divu darba dienu laikā. Tas dod drošību, nepadarot tevi atkarīgu no manis.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- PRINCIPLES -->
  <section class="principles">
    <div class="wrap">
      <div class="section-head" style="max-width:760px;">
        <div class="eyebrow">Manas vērtības</div>
        <h2 class="section-title" style="margin-top:20px;">Trīs lietas, kas man ir <em>svarīgas.</em></h2>
      </div>

      <div class="principles-grid">

        <div class="principle">
          <img class="bicon" src="/assets/images/ieva-uztura-asinsanalizu-konteksts-ikona.webp" alt="Asinsanalīžu mēģene ar auga zariņu — lēmumi balstās uz taviem datiem, ne uz vidējo cilvēku" width="200" height="200" loading="lazy" />
          <h3>Precizitāte, ne minējumi</h3>
          <p>
            Lēmumus pieņemam, balstoties uz tavu ikdienu, paradumiem un, ja vajag,
            analīžu rādītājiem. Nekad pēc principa „visiem der viens”.
          </p>
        </div>

        <div class="principle">
          <img class="bicon" src="/assets/images/ieva-uztura-konsultacijas-atbalsts-ikona.webp" alt="Sirds auga vainagā — atbildība no abām pusēm: godīgs ieteikums no manis, darbs pie sevis no tevis" width="200" height="200" loading="lazy" />
          <h3>Atbildība no abām pusēm</h3>
          <p>
            Es atbildu par savu ieteikumu kvalitāti. Tu atbildi par darbu pie sevis.
          </p>
        </div>

        <div class="principle">
          <img class="bicon" src="/assets/images/ieva-uztura-ilgtermina-progress-ikona.webp" alt="Kāpnes ar augošu stiebru — izglītība, kas ļauj turpināt pašam, nevis atkarība no konsultanta" width="200" height="200" loading="lazy" />
          <h3>Zināšanas, kas paliek arī pēc manis</h3>
          <p>
            Katram ieteikumam pasaku pamatojumu. Tāpēc pēc darba ar mani tu zini,
            <em>kāpēc</em> kaut ko dari, un vari turpināt patstāvīgi.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section class="credentials">
    <div class="wrap">
      <div class="section-head" style="max-width:760px;">
        <div class="eyebrow">Izglītība un sertifikāti</div>
        <h2 class="section-title" style="margin-top:20px;">Mans darbs balstās <em>uz nepārtrauktu sevis pilnveidi un attīstību.</em></h2>
        <p class="lede" style="margin-top:20px;">
          Šeit vari apskatīt manus iegūtos sertifikātus — no ITEC un fitnesa trenera
          pamatkvalifikācijas līdz atsevišķiem kursiem par hormoniem, mikrobiomu un
          analīžu rādītājiem. Oriģinālus varu uzrādīt pēc pieprasījuma.
        </p>
      </div>

      <div class="cert-grid">

        <figure class="cert-card">
          <img
            src="/assets/images/certificates/ieva-jekabsone-itec-nutriologijas-sertifikats.webp"
            alt="ITEC sertifikāts — Level 3 Certificate in Diet and Nutrition for Complementary Therapists ar novērtējumu Merit, izsniegts Ievai Vinkai 2022. gadā, Ofqual regulēta kvalifikācija"
            width="1200" height="1697" loading="lazy"
          />
          <figcaption>
            <strong>ITEC nutrioloģijā</strong>
            <span>Level 3 Diet and Nutrition · vērtējums Merit · Ofqual regulēta kvalifikācija · 2022</span>
          </figcaption>
        </figure>

        <figure class="cert-card">
          <img
            src="/assets/images/certificates/ieva-jekabsone-praktiska-nutriologija-sertifikats.webp"
            alt="LMacademy sertifikāts par praktiskās nutrioloģijas kursu ar nokārtotu eksāmenu, izsniegts Ievai Vinkai 2022. gada decembrī"
            width="1139" height="879" loading="lazy"
          />
          <figcaption>
            <strong>Praktiskā nutrioloģija</strong>
            <span>LMacademy · kurss ar eksāmenu · 2022</span>
          </figcaption>
        </figure>

        <figure class="cert-card">
          <img
            src="/assets/images/certificates/ieva-jekabsone-asinsanalizu-lasisana-sertifikats.webp"
            alt="GOGO school sertifikāts par kursu analīžu rādītāju izpratnē, izsniegts Ievai Vinkai"
            width="1200" height="857" loading="lazy"
          />
          <figcaption>
            <strong>Analīžu rādītāji uzturā</strong>
            <span>GOGO school · kurss</span>
          </figcaption>
        </figure>

        <figure class="cert-card">
          <img
            src="/assets/images/certificates/ieva-jekabsone-uzturs-un-hormoni-sertifikats.webp"
            alt="GOGO school sertifikāts par kursu „Uzturs un hormoni”, izsniegts Ievai Vinkai"
            width="1200" height="850" loading="lazy"
          />
          <figcaption>
            <strong>Uzturs un hormoni</strong>
            <span>GOGO school · kurss</span>
          </figcaption>
        </figure>

        <figure class="cert-card">
          <img
            src="/assets/images/certificates/ieva-jekabsone-zarnu-mikrobioma-biohimija-sertifikats.webp"
            alt="Starptautiskā integratīvās nutrioloģijas institūta sertifikāts par intensīvo kursu zarnu mikrobioma bioķīmijā, izsniegts Ievai Vinkai 2022. gada augustā"
            width="1200" height="879" loading="lazy"
          />
          <figcaption>
            <strong>Zarnu mikrobioma bioķīmija</strong>
            <span>Starptautiskais integratīvās nutrioloģijas institūts · 2022</span>
          </figcaption>
        </figure>

        <figure class="cert-card">
          <img
            src="/assets/images/certificates/ieva-jekabsone-lttc-c-kategorijas-trenera-apliectiba.webp"
            alt="Latvijas Treneru tālākizglītības centra apliecība par profesionālās pilnveides izglītību — C kategorijas sporta speciālists fitnesā, izsniegta Ievai Vinkai Rīgā 2021. gadā"
            width="1200" height="1678" loading="lazy"
          />
          <figcaption>
            <strong>C kategorijas fitnesa trenera sertifikāts</strong>
            <span>Latvijas Treneru tālākizglītības centrs · fitness · 2021</span>
          </figcaption>
        </figure>

      </div>

      <p class="cert-extra">
        Papildus tam — īsāki kursi par veselīgu uzturu (Gogo school, Miin, LMacademy, SPA school),
        kuriem atsevišķu apliecinājumu nav.
      </p>

      <p class="cert-note">
        * Vairāki agrāk izsniegtie sertifikāti ir uz iepriekšējo uzvārdu — <em>Vinka.</em>
        Pēc laulības Latvijā uzvārds tika nomainīts; izglītības saturs un kvalifikācija paliek nemainīgi.
      </p>
    </div>
  </section>

  <!-- NOT FOR -->
  <section class="not-for-section">
    <div class="wrap">
      <div class="not-for-grid">
        <div>
          <div class="eyebrow">Godīga saruna</div>
          <h2 class="section-title" style="margin-top:20px;">Ar ko es <em>nestrādāju.</em></h2>
          <p class="lede" style="margin-top:20px;">
            Pirms tu raksti, gribu būt godīga. Ir situācijas, kurās es neesmu īstais cilvēks.
          </p>
        </div>

        <ul class="not-for-list">
          <li>
            <span class="x-mark">×</span>
            <p><strong>Ja meklē ātru brīnumu</strong> — mīnus 10 kg mēneša laikā vai septiņu dienu detoksu. Es ar tādiem mērķiem nestrādāju.</p>
          </li>
          <li>
            <span class="x-mark">×</span>
            <p><strong>Ja gribi, lai kāds cits izdara darbu tavā vietā.</strong> Rezultātu rada tavas ikdienas izvēles, ne mana klātbūtne.</p>
          </li>
          <li>
            <span class="x-mark">×</span>
            <p><strong>Ja gribi dzirdēt tikai to, kas patīk.</strong> Es dažreiz pasaku neērtas lietas.</p>
          </li>
          <li>
            <span class="x-mark">×</span>
            <p><strong>Ja tev ir akūta veselības problēma</strong>, kas prasa ārsta uzraudzību. Es ārstu neaizstāju.</p>
          </li>
        </ul>
      </div>

      <p class="not-for-tagline">
        Bet, ja esi noguris no šabloniem un gatavs darīt darbu — <em>tad es varu tev palīdzēt.</em>
      </p>
    </div>
  </section>

  <!-- TRUST SIGNAL -->
  <section class="trust-signal">
    <div class="wrap trust-signal-inner">
      <div class="eyebrow center">Sāc bez maksas</div>
      <h2 style="margin-top:22px;">Vari sākt arī <em>bez manis.</em></h2>

      <div class="ornament">
        <span class="dot"></span><span class="bar"></span><span class="dot"></span>
      </div>

      <div class="trust-signal-body">
        <p>Pamatus — kas un kāpēc — esmu pierakstījusi Uztura ABC sadaļā un blogā. Tie ir brīvi pieejami, un ar tiem vari sākt jau šodien.</p>
        <p>Konsultācija ir tad, kad gribi kādu, kas izvērtē tavu situāciju un pasaka, kas tev patiešām vajadzīgs.</p>
      </div>

      <div style="display:flex; gap:16px; flex-wrap:wrap; justify-content:center;">
        <a href="/uztura-abc" class="btn btn-gold">Lasīt Uztura ABC <span class="arrow">→</span></a>
        <a href="/pakalpojumi" class="btn btn-ghost">Apskatīt pakalpojumus <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final">
    <div class="wrap final-inner">
      <span class="script">Sāksim?</span>
      <h2>Pieteikt sākuma konsultāciju. <em>49 €.</em></h2>

      <div class="final-ctas">
        <a href="/pakalpojumi/sakuma-konsultacija" class="btn btn-primary">Pieteikt konsultāciju — 49 € <span class="arrow">→</span></a>
      </div>

      <p>Sazināšos 24 stundu laikā.</p>
    </div>
  </section>

</BaseLayout>
