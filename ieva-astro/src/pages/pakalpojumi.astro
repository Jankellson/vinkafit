---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrustRow from '../components/TrustRow.astro';

const services = [
  {
    href: '/pakalpojumi/sakuma-konsultacija',
    label: 'Sākuma konsultācija',
    price: '49 €',
    amount: '49',
    recommended: true,
    text: 'Viena saruna: pārrunājam tavu situāciju, atbildu uz jautājumiem un pasaku, kāds ir tavs nākamais solis. Programma pēc tam nav obligāta.',
    image: '/assets/images/ieva-jekabsone-uztura-pieraksti-kafejnica.webp',
    alt: 'Ieva Jēkabsone kafejnīcā raksta uztura piezīmes blociņā — sākuma konsultācija, kurā pārrunājam tavu situāciju un nākamo soli',
  },
  {
    href: '/pakalpojumi/30-dienu-uztura-programma',
    label: '30 dienu programma',
    price: '249 €',
    amount: '249',
    text: 'Pirmais mēnesis ar konkrētu plānu: trīs konsultācijas, 30 dienu ēdienkartes ar receptēm un iepirkumu saraksti katrai nedēļai.',
    image: '/assets/images/ieva-iepirkumu-saraksts-darzeni-virtuve.webp',
    alt: 'Ieva Jēkabsone virtuvē pieraksta nedēļas iepirkumu sarakstu blakus svaigiem dārzeņiem — 30 dienu uztura programma ar ēdienkartēm un iepirkumu sarakstiem',
  },
  {
    href: '/pakalpojumi/90-dienu-uztura-programma',
    label: '90 dienu programma',
    price: '549 €',
    amount: '549',
    text: 'Trīs mēneši, kur katrs nākamais posms tiek pielāgots tavam progresam. Rezultāts — uztura kārtība, ko vari turpināt pats.',
    image: '/assets/images/ieva-teja-un-gramata-kresla.webp',
    alt: 'Ieva Jēkabsone lasa krēslā ar tējas krūzi un ogu bļodiņu — 90 dienu programma, kurā uztura sistēma tiek veidota pakāpeniski trīs mēnešos',
  },
  {
    href: '/pakalpojumi/vip-uztura-atbalsts',
    label: 'VIP uztura atbalsts',
    price: '1500 € / 6 mēneši',
    amount: '1500',
    text: 'Seši mēneši ar prioritāru atbildi tajā pašā darba dienā un divām plāna korekcijām mēnesī. Trīs vietas gadā.',
    image: '/assets/images/ieva-vasaras-pikniks-darza.webp',
    alt: 'Ieva Jēkabsone vasaras piknikā dārzā — VIP uztura atbalstā arī svētki, ceļojumi un ģimenes maltītes kļūst par sarunas daļu',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': services.map((service) => ({
    '@type': 'Service',
    provider: { '@id': 'https://ievajekabsone.lv/#ieva' },
    name: service.label,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      price: service.amount,
      url: `https://ievajekabsone.lv${service.href}`,
    },
    description: service.text,
  })),
};
---

<BaseLayout title="Uztura pakalpojumi — Ieva Jēkabsone" description="Sākuma uztura konsultācija 49 €, 30 dienu programma 249 €, 90 dienu programma 549 € un VIP uztura atbalsts. Izvēlies to, kas der tavai situācijai." canonical="https://ievajekabsone.lv/pakalpojumi" jsonLd={jsonLd} activeNav="pakalpojumi">
  <Breadcrumbs items={[{ label: 'Sākums', href: '/' }, { label: 'Pakalpojumi' }]} />

  <section class="offer-hero">
    <div class="wrap offer-hero-grid">
      <div>
        <p class="offer-kicker">Pakalpojumi</p>
        <h1>Uztura programmas <em>un cenas.</em></h1>
        <p class="lede">Sākam ar tavu situāciju, mērķiem un paradumiem. Tad izvēlamies programmu, kas atbilst tavam mērķim.</p>
        <a href="/pakalpojumi/sakuma-konsultacija" class="btn btn-primary">Pieteikt sākuma konsultāciju — 49 € <span class="arrow">→</span></a>
      </div>
      <figure class="offer-hero-photo"><img src="/assets/images/ieva-relaxed.webp" alt="Ieva Jēkabsone, ITEC sertificēta uztura konsultante — individuālas uztura programmas tiešsaistē latviešu un krievu valodā" width="1023" height="1537" loading="eager" /></figure>
    </div>
  </section>

  <section class="offer-note-section">
    <div class="wrap offer-note">
      <p class="offer-kicker">Kā izvēlēties</p>
      <h2>Ja nezini, ar ko sākt, <em>sāc ar konsultāciju.</em></h2>
      <p>49 € konsultācijā izrunājam tavus mērķus, paradumus, dzīvesveidu un pašsajūtu. Ja 24 stundu laikā izvēlies programmu, šo summu ieskaitu tās cenā.</p>
      <a href="/pakalpojumi/sakuma-konsultacija" class="btn btn-ghost">Uzzināt par sākuma konsultāciju <span class="arrow">→</span></a>
    </div>
  </section>

  <section class="offer-index">
    <div class="wrap">
      <div class="offer-index-intro">
        <p class="offer-kicker">Izvēlies savu nākamo soli</p>
        <h2>Viena ieeja. <em>Četri piedāvājumi.</em></h2>
      </div>
      <div class="offer-index-list">
        {services.map((service, index) => (
          <article class:list={['offer-index-item', service.recommended && 'offer-index-item--start']}>
            <img src={service.image} alt={service.alt} width="164" height="122" loading="lazy" />
            <div class="offer-index-copy">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3><a href={service.href}>{service.label}</a></h3>
              {service.recommended && <p class="offer-index-badge">Sāc šeit</p>}
              <p>{service.text}</p>
            </div>
            <div class="offer-index-action"><strong>{service.price}</strong><a href={service.href}>Skatīt piedāvājumu <span aria-hidden="true">→</span></a></div>
          </article>
        ))}
      </div>

      <TrustRow />

      <p class="offer-disclaimer">
        Programmās asinsanalīžu rādītājus apskatām tikai uztura un dzīvesveida kontekstā.
        Diagnozes noteikšana, ārstēšana un medikamentu nozīmēšana pakalpojumos neietilpst.
      </p>
    </div>
  </section>

  <section class="sales-cta-strip">
    <div class="wrap sales-cta-inner">
      <div>
        <h2>Nezini, kuru izvēlēties? <em>Sāc ar sarunu.</em></h2>
        <p>49 € konsultācijā izrunājam tavu situāciju. Ja 24 stundu laikā izvēlies programmu, summu ieskaitu tās cenā.</p>
      </div>
      <a class="btn btn-primary" href="https://pirkt.ievajekabsone.lv/1c583d0d">Pieteikt konsultāciju — 49 € <span class="arrow">→</span></a>
    </div>
  </section>
</BaseLayout>
