---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustRow from '../../components/TrustRow.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '90 dienu individuāls uztura plāns',
  provider: { '@id': 'https://ievajekabsone.lv/#ieva' },
  offers: { '@type': 'Offer', price: '549', priceCurrency: 'EUR', url: 'https://ievajekabsone.lv/pakalpojumi/90-dienu-uztura-programma' },
  description: 'Individuāls uztura plāns trīs secīgiem 30 dienu posmiem ar konsultācijām un atbalstu.'
};
---

<BaseLayout title="Individuāls uztura plāns 90 dienām | Ieva Jēkabsone" description="Individuāls uztura plāns 90 dienām: trīs secīgi posmi, konsultācijas, ēdienkartes un atbalsts, lai sistēmu nostiprinātu ikdienā." canonical="https://ievajekabsone.lv/pakalpojumi/90-dienu-uztura-programma" jsonLd={jsonLd} activeNav="pakalpojumi">
  <Breadcrumbs items={[{ label: 'Sākums', href: '/' }, { label: 'Pakalpojumi', href: '/pakalpojumi' }, { label: '90 dienu programma' }]} />
  <section class="service-hero sales-hero"><div class="wrap service-hero-grid"><div><p class="offer-kicker">Ievas ieteiktā izvēle · 549 €</p><h1>Individuāls uztura plāns, kas mainās <em>kopā ar tavu ikdienu.</em></h1><p class="lede">90 dienās neveidojam tikai pirmo ēdienkarti. Mēs veidojam sistēmu trīs secīgos posmos, lai tu saprastu, kas tev der un ko vari turpināt arī pēc programmas.</p><a class="btn btn-primary" href="/kontakti?paka=90-dienu-programma">Pieteikt sākuma konsultāciju — 49 € <span class="arrow">→</span></a></div><figure class="service-photo service-photo--hero"><img src="/assets/images/ieva-teja-un-gramata-kresla.webp" alt="Ieva Jēkabsone lasa krēslā ar tējas krūzi un ogu bļodiņu — 90 dienu programmā uztura sistēma top pakāpeniski, trīs secīgos posmos" loading="eager" /></figure></div></section>
  <section class="sales-situation sales-situation--plum"><div class="wrap sales-situation-grid"><div><p class="offer-kicker">Kāpēc 90 dienas</p><h2>Ar pirmo plānu bieži <em>nepietiek.</em></h2></div><div><p>Īss starts var palīdzēt saprast virzienu. Taču ikdiena mainās: darba ritms, ēst gatavošanas laiks, motivācija, ģimenes maltītes un situācijas, kurās vecie paradumi atgriežas.</p><p>Trīs mēneši ir pietiekami ilgs laiks, lai šīs izmaiņas pamanītu un plānu pielāgotu. Tāpēc šī ir mana ieteiktā izvēle cilvēkam, kurš grib ne tikai sākt, bet iemācīties turpināt.</p></div></div></section>
  <section class="sales-process"><div class="wrap"><p class="offer-kicker">Trīs secīgi posmi</p><h2>Plānu nesaņem vienā reizē. <em>Trīs mēnešos tas mainās kopā ar tavu progresu.</em></h2><div class="sales-steps"><article><img class="bicon" src="/assets/images/ieva-personigais-uztura-plans-ikona.webp" alt="Atvērta grāmata ar atzīmētu sarakstu un auga zaru — pirmajā mēnesī topa tavs personīgais plāns un pirmās 30 dienu maltītes" width="200" height="200" loading="lazy" /><span>1. mēnesis</span><h3>Izveidojam pamatu</h3><p>Sākuma konsultācija, prioritātes, pirmais plāns un konkrētas maltītes tavām 30 dienām.</p></article><article><img class="bicon" src="/assets/images/ieva-uztura-majas-gatavosana-ikona.webp" alt="Katls ar garšaugiem — otrajā mēnesī plānu pielāgojam tam, kas tavā virtuvē tiešām notika" width="200" height="200" loading="lazy" /><span>2. mēnesis</span><h3>Pielāgojam realitātei</h3><p>Skatāmies, kas notika praksē, un nākamo posmu veidojam pēc tavas pieredzes.</p></article><article><img class="bicon" src="/assets/images/ieva-uztura-ilgtermina-progress-ikona.webp" alt="Kāpnes ar augošu stiebru — trešajā mēnesī nostiprinām sistēmu, ko turpināsi bez ikdienas atbalsta" width="200" height="200" loading="lazy" /><span>3. mēnesis</span><h3>Nostiprinām sistēmu</h3><p>Noslēgumā sakārtojam to, ko turpināsi izmantot arī bez ikdienas atbalsta.</p></article></div></div></section>
  <section class="service-content"><div class="wrap service-two-col"><figure class="service-photo"><img src="/assets/images/ieva-pasniedz-vakarinas-darzenu-kvinoja.webp" alt="Ieva Jēkabsone pasniedz vakariņas ar ceptiem dārzeņiem un kvinoju — uztura plāns, kas iederas parastā ikdienas virtuvē" loading="lazy" /></figure><div><p class="offer-kicker">Kas ir iekļauts</p><h2>Ne tikai vairāk dienu. <em>Vairāk pielāgošanas.</em></h2><ul class="service-list"><li>5 konsultācijas: sākuma, pirmā plāna, 1. mēneša, 2. mēneša un noslēguma</li><li>3 secīgi 30 dienu posmi ar ēdienkartēm, receptēm, porcijām un iepirkumu sarakstiem</li><li>Katrs nākamais posms tiek pielāgots pēc iepriekšējās pieredzes</li><li>Praktiski uztura un dzīvesveida ieteikumi</li><li>Viena saskaņota plāna korekcija katrā posmā</li><li>Rakstisks vai balss atbalsts 12 nedēļas: viens apvienots ziņojums nedēļā ar līdz 3 jautājumiem un viena atbilde 2 darba dienu laikā</li></ul></div></div></section>
  <section class="sales-fit"><div class="wrap sales-fit-grid"><div><p class="offer-kicker">Šī programma der, ja</p><h2>Gribi ne tikai plānu, bet <em>savu sistēmu.</em></h2><ul class="service-list"><li>Tev svarīgi redzēt, kā ieteikumi darbojas vairākus mēnešus, ne tikai pāris nedēļas</li><li>Gribi laiku, lai jaunie paradumi nostiprinātos, nevis ātru, īslaicīgu rezultātu</li><li>Vēlies, lai nākamā mēneša plāns balstās uz iepriekšējo pieredzi</li></ul></div><div class="sales-fit-note"><p class="offer-kicker">Neizvēlies šo, ja</p><p>Šobrīd vēlies tikai īsu, ļoti konkrētu startu un neesi gatava trīs mēnešu darbam. Tad 30 dienu programma būs skaidrāks pirmais solis.</p><a href="/pakalpojumi/30-dienu-uztura-programma">Skatīt 30 dienu programmu <span aria-hidden="true">→</span></a></div></div></section>
  <section class="sales-price"><div class="wrap sales-price-inner"><div><p class="offer-kicker">Cena un nākamais solis</p><h2>90 dienu programma — <em>549 €.</em></h2><p>Vispirms piesakies 49 € sākuma konsultācijai. Ja 24 stundu laikā izvēlies 90 dienu programmu, konsultācijas maksu ieskaitu cenā, un programmas atlikums ir 500 €.</p></div><a class="btn btn-primary" href="/kontakti?paka=90-dienu-programma">Sākt ar konsultāciju <span class="arrow">→</span></a></div></section>
  <div class="wrap trust-wrap"><TrustRow /></div>
  <section class="sales-faq"><div class="wrap"><p class="offer-kicker">Bieži jautājumi</p><h2>Skaidri nosacījumi, <em>pirms sākam.</em></h2><div class="sales-faq-list"><details><summary>Vai katram mēnesim būs jauna ēdienkarte?</summary><p>Jā. Programma sastāv no trim secīgiem 30 dienu posmiem. Katru nākamo posmu pielāgojam, ņemot vērā iepriekšējā pieredzi.</p></details><details><summary>Vai man jābūt gatavām analīzēm?</summary><p>Nē. Ja iesniedz savus rezultātus, tos pārrunājam uztura un dzīvesveida kontekstā un izmantojam plāna prioritāšu noteikšanai.</p></details><details><summary>Kāda ir atšķirība no VIP atbalsta?</summary><p>90 dienu programma dod skaidru, regulāru procesu. VIP ir sešu mēnešu sadarbība ar prioritāru pieejamību, vairāk konsultācijām un praktisku atbalstu arī ikdienas situācijās.</p></details></div><p class="service-disclaimer">Asinsanalīžu rezultāti tiek apskatīti tikai uztura un dzīvesveida kontekstā. Pakalpojums neietver diagnozes noteikšanu, ārstēšanu vai medikamentu nozīmēšanu.</p></div></section>
  <section class="sales-cta-strip"><div class="wrap sales-cta-inner"><div><h2>Sākam ar sarunu, <em>tad ar plānu.</em></h2><p>Vispirms 49 € konsultācija. Ja 24 stundu laikā izvēlies šo programmu, summu ieskaitu tās cenā.</p></div><a class="btn btn-primary" href="/kontakti?paka=90-dienu-programma">Pieteikt konsultāciju — 49 € <span class="arrow">→</span></a></div></section>
  <a class="sales-sticky" href="/kontakti?paka=90-dienu-programma">Pieteikt konsultāciju — 49 €</a>
</BaseLayout>
