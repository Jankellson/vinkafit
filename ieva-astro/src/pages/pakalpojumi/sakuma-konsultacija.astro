---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const jsonLd = { '@context': 'https://schema.org', '@type': 'Service', name: 'Uztura konsultācija', provider: { '@id': 'https://ievajekabsone.lv/#ieva' }, offers: { '@type': 'Offer', price: '49', priceCurrency: 'EUR', url: 'https://ievajekabsone.lv/pakalpojumi/sakuma-konsultacija' }, description: 'Sākuma uztura konsultācija mērķu, paradumu, dzīvesveida un nākamā soļa pārrunāšanai.' };
---

<BaseLayout title="Uztura konsultācija — sākuma saruna par 49 € | Ieva Jēkabsone" description="Uztura konsultācija, kurā pārrunājam mērķus, paradumus un nākamo soli. Ja 24 stundu laikā izvēlies programmu, 49 € ieskaitu tās cenā." canonical="https://ievajekabsone.lv/pakalpojumi/sakuma-konsultacija" jsonLd={jsonLd} activeNav="pakalpojumi">
  <Breadcrumbs items={[{ label: 'Sākums', href: '/' }, { label: 'Pakalpojumi', href: '/pakalpojumi' }, { label: 'Sākuma konsultācija' }]} />
  <section class="service-hero sales-hero"><div class="wrap service-hero-grid"><div><p class="offer-kicker">Uztura konsultācija · 49 €</p><h1>Sāc ar sarunu, kas iedod <em>skaidru nākamo soli.</em></h1><p class="lede">Pārrunāsim tavu mērķi, ikdienas paradumus, dzīvesveidu un to, kas līdz šim nav strādājis. Pēc sarunas tu zināsi, ar ko sākt un vai tev vajadzīga programma.</p><a class="btn btn-primary" href="/kontakti?paka=sakuma-konsultacija">Pieteikt konsultāciju — 49 € <span class="arrow">→</span></a></div><aside class="price-panel"><span>Sākuma konsultācija</span><strong>49 €</strong><p>Ja 24 stundu laikā izvēlies 30 vai 90 dienu programmu, šo summu ieskaitu programmas cenā.</p></aside></div></section>
  <section class="sales-situation"><div class="wrap sales-situation-grid"><div><p class="offer-kicker">Nav jāzina viss iepriekš</p><h2>Tev nav uzreiz jāizvēlas <em>lielākā programma.</em></h2></div><div><p>Varbūt esi izmēģinājusi vairākus padomus un nezini, kas ir vērts tavā situācijā. Varbūt gribi plānu, bet neesi pārliecināta, cik dziļu atbalstu tev patiešām vajag.</p><p>Sākuma konsultācija ir pirmais solis, nevis pārdošanas zvans. Tā dod vietu izrunāt situāciju un izvēlēties piemērotāko turpinājumu.</p></div></div></section>
  <section class="sales-process"><div class="wrap"><p class="offer-kicker">Ko pārrunāsim</p><h2>Vispirms saprotam situāciju. <em>Tad plānojam.</em></h2><div class="sales-steps"><article><span>01</span><h3>Tavs mērķis</h3><p>Ko vēlies panākt un kāpēc tas tev šobrīd ir svarīgi.</p></article><article><span>02</span><h3>Tava ikdiena</h3><p>Ēšanas paradumus, ritmu, dzīvesveidu un to, kas rada grūtības.</p></article><article><span>03</span><h3>Nākamais solis</h3><p>Vai pietiek ar skaidru virzienu, vai ir vērts sākt 30 vai 90 dienu programmu.</p></article></div></div></section>
  <section class="service-content"><div class="wrap service-two-col"><figure class="service-photo"><img src="/assets/images/ieva-konsultacija-kafejnica.webp" alt="Ieva Jēkabsone sarunā uztura konsultācijas laikā" /></figure><div><p class="offer-kicker">Pēc konsultācijas</p><h2>Tu nepaliec ar vēl vienu <em>vispārīgu padomu.</em></h2><ul class="service-list"><li>Tu skaidrāk saproti, kas šobrīd ir svarīgākais</li><li>Redzi, kāds atbalsta līmenis tev būtu piemērots</li><li>Ja programma nav vajadzīga, zini, ar ko sākt pati</li><li>Ja izvēlies turpināt, konsultācija kļūst par programmas pirmo soli</li></ul></div></div></section>
  <section class="sales-fit"><div class="wrap sales-fit-grid"><div><p class="offer-kicker">Sāc ar konsultāciju, ja</p><h2>Vajag skaidrību, nevis <em>spiedienu pirkt.</em></h2><ul class="service-list"><li>Nezini, vai tev vajag 30 vai 90 dienu programmu</li><li>Gribi vispirms izrunāt savu situāciju ar Ievu</li><li>Tev ir konkrēts jautājums par uzturu, ikdienas paradumiem vai nākamo soli</li></ul></div><div class="sales-fit-note"><p class="offer-kicker">Svarīgi zināt</p><p>Konsultācija nenosaka diagnozes un neaizstāj medicīnisku palīdzību. Tā ir uztura un dzīvesveida saruna, kuras mērķis ir palīdzēt tev izvēlēties praktisku nākamo soli.</p></div></div></section>
  <section class="sales-price"><div class="wrap sales-price-inner"><div><p class="offer-kicker">Pieraksts</p><h2>Sākuma konsultācija — <em>49 €.</em></h2><p>Ja 24 stundu laikā pēc konsultācijas izvēlies 30 vai 90 dienu programmu, 49 € ieskaitu izvēlētās programmas cenā.</p></div><a class="btn btn-primary" href="/kontakti?paka=sakuma-konsultacija">Pieteikt konsultāciju <span class="arrow">→</span></a></div></section>
  <section class="sales-faq"><div class="wrap"><p class="offer-kicker">Bieži jautājumi</p><h2>Pirms sarunas <em>nav jāsagatavo perfekta atbilde.</em></h2><div class="sales-faq-list"><details><summary>Vai konsultācija notiek tiešsaistē?</summary><p>Jā. Pēc pieteikuma Ieva vienojas ar tevi par piemērotu laiku tiešsaistes sarunai.</p></details><details><summary>Vai pēc konsultācijas man obligāti jāpērk programma?</summary><p>Nē. Konsultācijas uzdevums ir saprast situāciju un nākamo soli. Turpini programmā tikai tad, ja tas tev ir piemēroti.</p></details><details><summary>Vai drīkstu pieteikties, ja man vēl nav analīžu?</summary><p>Jā. Analīzes nav priekšnoteikums sākuma konsultācijai.</p></details></div></div></section>
</BaseLayout>
