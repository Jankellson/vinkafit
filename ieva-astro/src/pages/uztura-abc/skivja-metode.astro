  color: rgba(255,248,242,.78); margin: 0 0 22px; max-width: 60ch;
}
.ip-sc-list { list-style: none; padding: 0; margin: 0; }
.ip-sc-item {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; padding: 14px 0;
  border-bottom: 1px solid rgba(235,192,126,.18);
}
.ip-sc-q { font-size: 14.5px; line-height: 1.45; color: var(--cream); }
.ip-sc-toggle { display: flex; gap: 6px; flex-shrink: 0; }
.ip-sc-btn {
  font-family: var(--sans); font-size: 13px;
  min-width: 52px; padding: 8px 14px;
  background: transparent; color: rgba(255,248,242,.8);
  border: 1px solid rgba(235,192,126,.4);
  border-radius: 2px; cursor: pointer;
  transition: background .15s, color .15s, border-color .15s;
}
.ip-sc-btn:hover { border-color: var(--gold); color: var(--cream); }
.ip-sc-btn[aria-pressed="true"][data-val="1"] {
  background: #6aaa64; border-color: #6aaa64; color: #fff; font-weight: 600;
}
.ip-sc-btn[aria-pressed="true"][data-val="0"] {
  background: var(--burgundy); border-color: var(--burgundy); color: #fff; font-weight: 600;
}
.ip-sc-result {
  margin-top: 24px; padding-top: 22px;
  border-top: 1px solid rgba(235,192,126,.25);
}
.ip-sc-meter {
  height: 8px; border-radius: 4px;
  background: rgba(255,248,242,.14);
  overflow: hidden; margin-bottom: 14px;
}
.ip-sc-meter-fill {
  display: block; height: 100%; width: 0;
  background: var(--gold);
  transition: width .4s ease, background .4s ease;
}
.ip-sc-score {
  font-family: var(--sans); font-size: 12px;
  letter-spacing: .12em; text-transform: uppercase;
  color: rgba(255,248,242,.7); margin-bottom: 10px;
}
.ip-sc-score strong { color: var(--gold); font-size: 16px; }
.ip-sc-verdict {
  font-size: 15px; line-height: 1.6; color: var(--cream);
}
.ip-sc-verdict strong { color: var(--gold); }

/* ─── Responsive ─────────────────────────────────────── */
@media (max-width: 860px) {
  .ip-cover-strip-grid { grid-template-columns: 1fr; }
  .ip-cover h1 { max-width: none; }
}
@media (max-width: 1024px) {
  .ip-wrap { grid-template-columns: 1fr; }
  .ip-sidebar { display: none; }
  .ip-prop-grid { grid-template-columns: 1fr; }
  .ip-tips-grid { grid-template-columns: 1fr; }
  .ip-plate-wrap { grid-template-columns: 1fr; }
  .ip-nav-footer { grid-template-columns: 1fr; gap: 2px; }
}
@media (max-width: 640px) {
  .ip-stats { grid-template-columns: repeat(2, 1fr); max-width: 300px; gap: 12px 0; }
  .ip-stat { padding: 12px 16px 12px 0; margin-right: 16px; }
  .ip-nav-card { padding: 18px 16px; gap: 12px; }
  .ip-nav-title { font-size: 14px; }
  .ip-sc-item { flex-direction: column; align-items: flex-start; gap: 10px; }
  .ip-sc-toggle { width: 100%; }
  .ip-sc-btn { flex: 1; }
}
</style>

<script>
  // Dinamisks TOC top — zem .nav + article-nav
  function setTocTop() {
    const anav = document.getElementById('article-nav');
    const toc  = document.querySelector<HTMLElement>('.ip-toc');
    if (!toc) return;
    if (anav) {
      const anavTop    = parseFloat(anav.style.top) || 0;
      const anavHeight = anav.offsetHeight;
      toc.style.top = `${anavTop + anavHeight + 12}px`;
    } else {
      const nav = document.querySelector<HTMLElement>('header.nav, .nav');
      toc.style.top = `${(nav ? nav.offsetHeight : 0) + 12}px`;
    }
  }
  setTocTop();
  window.addEventListener('resize', setTocTop, { passive: true });

  // FAQ accordion
  document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-q');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  // Sticky TOC — highlight active section on scroll
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.ip-toc-link');
  const headings = document.querySelectorAll<HTMLElement>('.ip-content h2[id]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
          });
        }
      });
    },
    { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
  );

  headings.forEach(h => observer.observe(h));

  // ─── Interaktīvā paškontrole ──────────────────────────
  const sc = document.querySelector<HTMLElement>('[data-selfcheck]');
  if (sc) {
    const items   = Array.from(sc.querySelectorAll<HTMLElement>('.ip-sc-item'));
    const result  = sc.querySelector<HTMLElement>('[data-sc-result]');
    const fill     = sc.querySelector<HTMLElement>('[data-sc-fill]');
    const numEl   = sc.querySelector<HTMLElement>('[data-sc-num]');
    const verdict = sc.querySelector<HTMLElement>('[data-sc-verdict]');
    const total   = items.length;
    const answers = new Array<number | null>(total).fill(null);

    function render() {
      const done = answers.filter(a => a !== null).length;
      if (done === 0 || !result) return;
      result.hidden = false;
      const yes = answers.filter(a => a === 1).length;
      if (fill)  fill.style.width = `${(yes / total) * 100}%`;
      if (numEl) numEl.textContent = String(yes);

      let html = '';
      let color = 'var(--gold)';
      if (done < total) {
        html = `<strong>Vēl ${total - done} ${total - done === 1 ? 'jautājums' : 'jautājumi'}.</strong> Atbildi uz visiem, lai redzētu pilnu vērtējumu.`;
      } else if (yes === total) {
        color = '#6aaa64';
        html = '<strong>Lielisks līdzsvars.</strong> Tavs šķīvis atbilst metodei visās sešās lietās. Turpini tāpat — pamats ir vietā.';
      } else if (yes >= 4) {
        html = '<strong>Gandrīz tur.</strong> Pamats ir labs, bet viena vai divas lietas vēl jāpaskata. Pārlasi rindas, kur atzīmēji "Nē" — tieši tās dod lielāko atšķirību.';
      } else {
        color = 'var(--gold)';
        html = '<strong>Vērts pārskatīt.</strong> Daži pamatelementi pietrūkst. Sāc ar diviem: dārzeņu pusi un veseliem graudiem — tie maina visvairāk. Pārējais nāk pakāpeniski.';
      }
      if (fill) fill.style.background = color;
      if (verdict) verdict.innerHTML = html;
    }

    items.forEach((item, i) => {
      const btns = Array.from(item.querySelectorAll<HTMLButtonElement>('.ip-sc-btn'));
      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          btns.forEach(b => b.setAttribute('aria-pressed', 'false'));
          btn.setAttribute('aria-pressed', 'true');
          answers[i] = Number(btn.dataset.val);
          render();
        });
      });
    });
  }
</script>
