---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleNav from '../../components/ArticleNav.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import Infographic from '../../components/Infographic.astro';

// ─── NotebookLM-generated multimedia ─────────────────────
// Šie tukšumi tiks aizpildīti, kad NotebookLM video + infografikas gatavas.
// Pagaidām: false = sloti netiek rādīti lapā.
const videoId: string | null      = null;  // YouTube ID, piem. "dQw4w9WgXcQ"
const videoTitle: string          = 'Šķīvja metode — vienkāršs veids, kā plānot ēdienreizi';
const videoDuration: string       = '4:12';

const infographicMain: string | null = null;  // /assets/images/skivja-metode-infografika-1.webp
const infographicMistakes: string | null = null;  // /assets/images/skivja-metode-infografika-2.webp

const title = "Šķīvja metode: princips, proporcijas un kā to izmantot ikdienā";
const description = "Šķīvja metode dala šķīvi trīs daļās — puse dārzeņiem, ceturtdaļa veseliem graudiem, ceturtdaļa olbaltumvielām. Hārvardas modelis, biežākās kļūdas un praktiski piemēri.";
const canonical = "https://ievajekabsone.lv/uztura-abc/skivja-metode";

const prevArticle = null;
const nextArticle = {
  href:  '/uztura-abc/makrouzturvielas',
  label: 'Makrouzturvielas',
  full:  'Makrouzturvielas: olbaltumvielas, tauki un ogļhidrāti — normas un avoti',
};

const tocItems = [
  { id: "kas-ir",       label: "Kas ir šķīvja metode un kā tā radās" },
  { id: "proporcijas",  label: "Proporcijas — ko tas nozīmē praksē" },
  { id: "ikdienaa",     label: "Kā tas izskatās reālos piemēros" },
  { id: "kludas",       label: "Biežākās kļūdas, ko redzu praksē" },
  { id: "arpur-majas",  label: "Šķīvja metode ārpus mājas" },
  { id: "vs-kalorijas", label: "Šķīvja metode salīdzinājumā ar kaloriju skaitīšanu" },
  { id: "zinatne",      label: "Ko saka zinātne" },
  { id: "faq",          label: "Bieži uzdotie jautājumi" },
];

const faqItems = [
  {
    q: "Vai šķīvja metode der svara samazināšanai?",
    a: "Jā. Tā automātiski uzlabo ēdienreižu struktūru un bieži samazina kaloriju daudzumu — bez skaitīšanas. Taču, ja ir hormonālas problēmas vai insulīna rezistence, ar šķīvja metodi vien var nepietikt. Tad vajag individuālu pieeju."
  },
  {
    q: "Ko darīt, ja ēdu veģetāri — kur ņemt olbaltumvielas?",
    a: "Labi olbaltumvielu avoti ir pākšaugi (lēcas, aunazirņi, pupiņas), tofu, tempehs, olas un piena produkti. Pākšaugi papildus dod šķiedrvielas, tāpēc bieži aizpilda gan olbaltumvielu, gan daļu dārzeņu vietas vienlaikus."
  },
  {
    q: "Vai šķīvja metode jāievēro katrā ēdienreizē?",
    a: "Nē. Šķīvja metode ir orientieris, nevis stingrs noteikums. Galvenais — raudzīties uz visas dienas kopainu, nevis uz katru ēdienreizi atsevišķi. Ja brokastīs ir auzu biezputra ar ogām, bet vakariņās — dārzeņi, dienas bilance ir laba."
  },
  {
    q: "Kā šķīvja metode izskatās, ja ēdu zupu vai sautējumu?",
    a: "Skaties uz satura proporcijām, nevis trauka formu. Pārbaudi: vai zupā ir dārzeņi? Olbaltumvielas (gaļa vai pākšaugi)? Graudi (griķi, rīsi vai maize klāt)? Ja ir — šķīvja metodes princips ir ievērots."
  },
  {
    q: "Cik lielam jābūt šķīvim?",
    a: "Parasts pusdienu šķīvis ar 22–24 cm diametru ir labs orientieris. Ja ēd no 30 cm vai lielāka šķīvja, porcijas gandrīz noteikti ir par lielām — psiholoģiski mēs cenšamies piepildīt to, kas priekšā."
  },
  {
    q: "Vai porcijas jāsver?",
    a: "Nē — un tā ir šķīvja metodes galvenā priekšrocība. Ja šķīvja puse tiešām ir dārzeņi, ceturtdaļa — olbaltumvielas, ceturtdaļa — graudi, esi uz pareizā ceļa. Bez svariem un lietotnēm."
  },
  {
    q: "Vai kartupelis tiešām neskaitās dārzeņos?",
    a: "Šķīvja metodē — nē. Hārvardas Sabiedrības veselības skola kartupeli pieskaita pie graudu/cietes daļas, nevis dārzeņiem, augstā glikēmiskā indeksa dēļ: tas cukura līmeni asinīs paaugstina līdzīgi kā baltmaize. Tas nenozīmē, ka kartupelis ir aizliegts — vienkārši ieskaiti to ¼ graudu daļā, ne ½ dārzeņu daļā."
  },
  {
    q: "Cik bieži pēc šķīvja metodes jāēd zivis?",
    a: "Vismaz divas reizes nedēļā, no kurām vismaz vienu reizi treknu zivi (lasis, siļķe, makrele) omega-3 taukskābju dēļ. Pārējās ēdienreizēs olbaltumvielu daļu var aizpildīt ar vistu, olām, pākšaugiem vai piena produktiem. Sarkano gaļu — retāk, desas un kūpinājumus — pēc iespējas reti."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "url": canonical,
      "datePublished": "2026-05-26",
      "dateModified": "2026-05-28",
      "author": {
        "@type": "Person",
        "name": "Ieva Jēkabsone",
        "@id": "https://ievajekabsone.lv/#ieva",
        "jobTitle": "Uztura konsultante",
        "url": "https://ievajekabsone.lv/par-mani"
      },
      "publisher": { "@type": "Person", "name": "Ieva Jēkabsone", "@id": "https://ievajekabsone.lv/#ieva" },
      "inLanguage": "lv",
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonical }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Sākums", "item": "https://ievajekabsone.lv/" },
        { "@type": "ListItem", "position": 2, "name": "Uztura ABC", "item": "https://ievajekabsone.lv/uztura-abc" },
        { "@type": "ListItem", "position": 3, "name": "Šķīvja metode", "item": canonical }
      ]
    }
  ]
};
---

<BaseLayout
  title={`${title} | Ieva Jēkabsone`}
  description={description}
  canonical={canonical}
  ogImage="/images/raksti/skivja-metode/skivja-metode-og.webp"
  jsonLd={jsonLd}
  activeNav="uztura-abc"
>

  <ArticleNav
    breadcrumbs={[
      { label: 'Sākums',     href: '/' },
      { label: 'Uztura ABC', href: '/uztura-abc' },
      { label: 'Šķīvja metode' },
    ]}
    prev={prevArticle}
    next={nextArticle}
  />

  <!-- ══ ARTICLE HERO — ŽURNĀLA VĀKS ═══════════════════════════ -->
  <section class="ip-cover">
    <!-- Full-width image with title overlaid -->
    <div class="ip-cover-media">
      <img
        class="ip-cover-img"
        src="/images/raksti/skivja-metode/skivja-metode-cover.webp"
        alt="Veselīgs šķīvis ar dārzeņiem, brūnajiem rīsiem un ceptu zivi — šķīvja metodes piemērs"
        width="1200" height="630"
        loading="eager"
      />
      <div class="ip-cover-scrim" aria-hidden="true"></div>
      <div class="ip-cover-inner wrap">
        <div class="ip-eyebrow">Uztura pamati · Bloks 01</div>
        <h1>Šķīvja metode: princips, proporcijas un <em>kā to izmantot ikdienā</em></h1>
        <p class="ip-lede">
          Vienkāršs veids, kā plānot ēdienreizi bez kaloriju skaitīšanas.
          Hārvardas modelis, kur pareizas proporcijas ir svarīgākas nekā precīzi grami.
        </p>
      </div>
    </div>

    <!-- Light strip below: quick answer + stats -->
    <div class="ip-cover-strip">
      <div class="wrap ip-cover-strip-grid">
        <div class="ip-quickans">
          <div class="ip-quickans-label">Īsā atbilde</div>
          <p>
            <strong>Puse šķīvja</strong> — dārzeņi un augļi. &nbsp;
            <strong>Ceturtdaļa</strong> — veseli graudi. &nbsp;
            <strong>Ceturtdaļa</strong> — olbaltumvielas. &nbsp;
            Klāt nedaudz veselīgu tauku. Dzeram ūdeni.
          </p>
        </div>
        <div class="ip-cover-stats-wrap">
          <div class="ip-stats">
            <div class="ip-stat"><strong>½</strong><span>Dārzeņi un augļi</span></div>
            <div class="ip-stat"><strong>¼</strong><span>Veseli graudi</span></div>
            <div class="ip-stat"><strong>¼</strong><span>Olbaltumvielas</span></div>
            <div class="ip-stat"><strong>−30%</strong><span>Diabēta risks*</span></div>
          </div>
          <p class="ip-stats-note">* Hārvardas ilgtermiņa pētījumu dati salīdzinājumā ar tipisku Rietumvalstu uzturu</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ MAIN LAYOUT: TOC + CONTENT ═══════════════════════════ -->
  <div class="ip-wrap wrap">

    <!-- LEFT: sidebar — Ieva card (static) + sticky TOC -->
    <aside class="ip-sidebar" aria-label="Satura rādītājs">

      <!-- STATIC: Ieva info card — scrolls away -->
      <div class="ip-toc-ieva">
        <img
          src="/assets/images/ieva-portrait.webp"
          alt="Ieva Jēkabsone"
          class="ip-toc-ieva-img"
          width="80" height="80"
        />
        <div class="ip-toc-ieva-name">Ieva Jēkabsone</div>
        <div class="ip-toc-ieva-role">Uztura konsultante</div>
        <p class="ip-toc-ieva-bio">
          Palīdzu saprast, kas uzturā kaitē un kas palīdz.
          Bez stingrām diētām un kaloriju skaitīšanas.
        </p>
        <div class="ip-toc-socials">
          <a href="https://www.instagram.com/ieva.jekabsone/" target="_blank" rel="noopener"
             class="ip-toc-social" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=100089137514285" target="_blank" rel="noopener"
             class="ip-toc-social" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@ieva.jekabson" target="_blank" rel="noopener"
             class="ip-toc-social" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.73a4.85 4.85 0 0 1-1.01-.04z"/>
            </svg>
          </a>
        </div>
        <a href="/pakalpojumi" class="ip-toc-cta">Piesakies konsultācijai →</a>
      </div>

      <!-- STICKY: table of contents only -->
      <div class="ip-toc">
        <div class="ip-toc-inner">
          <div class="ip-toc-label">Saturs</div>
          <nav>
            <ol class="ip-toc-list">
              {tocItems.map(item => (
                <li><a href={`#${item.id}`} class="ip-toc-link">{item.label}</a></li>
              ))}
            </ol>
          </nav>
        </div>
      </div>

    </aside>

    <!-- RIGHT: article content -->
    <article class="ip-content">

      <!-- ─── Section 1 ─────────────────────────── -->
      <h2 id="kas-ir">Kas ir šķīvja metode un kā tā radās</h2>

      <p>
        Šķīvja metode jeb angliski <em>Healthy Eating Plate</em> ir vizuāls
        uztura plānošanas rīks. To 2011. gadā publicēja
        <a href="https://www.hsph.harvard.edu/nutritionsource/healthy-eating-plate/" target="_blank" rel="noopener">Hārvardas Sabiedrības veselības skola</a>.
        Tā radās kā zinātniski pamatota alternatīva ASV Lauksaimniecības
        ministrijas <em>MyPlate</em> modelim. Hārvardas pētnieki uzskatīja, ka
        MyPlate ir pārāk vispārīgs un noklusē veselīgo tauku nozīmi.
      </p>

      <p>
        No citiem modeļiem to atšķir trīs lietas. Pirmkārt, tā nosauc
        <strong>konkrētu graudu veidu</strong> — vesli graudi, nevis jebkādi.
        Otrkārt, <strong>veselīgos taukus</strong> tā iekļauj kā obligātu
        sastāvdaļu. Treškārt, kā galveno dzērienu iesaka
        <strong>ūdeni</strong>, nevis pienu.
      </p>

      <!-- ─── Visual plate infographic ─────────── -->
      <div class="ip-plate-wrap" aria-label="Šķīvja metodes vizualizācija">
        <div class="ip-plate-diagram">
          <!-- SVG pie chart — 3 sektori -->
          <svg class="ip-plate-svg" viewBox="0 0 200 200" aria-hidden="true" role="img">
            <!-- Plate shadow -->
            <circle cx="100" cy="103" r="89" fill="rgba(42,20,25,.08)"/>
            <!-- Plate base -->
            <circle cx="100" cy="100" r="89" fill="white"/>
            <!-- ½ Dārzeņi — left half (counter-clockwise: top → left → bottom) -->
            <path d="M100,100 L100,11 A89,89 0 0,0 100,189 Z" fill="#6aaa64"/>
            <!-- ¼ Graudi — top-right (clockwise: top → right) -->
            <path d="M100,100 L100,11 A89,89 0 0,1 189,100 Z" fill="#e8c06d"/>
            <!-- ¼ Olbaltumvielas — bottom-right (clockwise: right → bottom) -->
            <path d="M100,100 L189,100 A89,89 0 0,1 100,189 Z" fill="#c4526e"/>
            <!-- Dividing lines -->
            <line x1="100" y1="11" x2="100" y2="189" stroke="white" stroke-width="2.5"/>
            <line x1="100" y1="100" x2="189" y2="100" stroke="white" stroke-width="2.5"/>
            <!-- Plate rim -->
            <circle cx="100" cy="100" r="89" fill="none" stroke="white" stroke-width="5"/>
            <circle cx="100" cy="100" r="89" fill="none" stroke="rgba(42,20,25,.12)" stroke-width="1"/>
            <!-- Fraction labels inside segments -->
            <text x="52" y="105" text-anchor="middle" fill="white" font-size="18" font-weight="700" opacity=".9">½</text>
            <text x="148" y="68"  text-anchor="middle" fill="white" font-size="15" font-weight="700" opacity=".9">¼</text>
            <text x="148" y="145" text-anchor="middle" fill="white" font-size="15" font-weight="700" opacity=".9">¼</text>
          </svg>
          <!-- Water glass -->
          <div class="ip-plate-glass">
            <svg viewBox="0 0 32 44" fill="none" aria-hidden="true">
              <path d="M6 3h20l-3 22H9L6 3Z" stroke="#9aabae" stroke-width="1.5" fill="#e8f4f7" fill-opacity=".6"/>
              <path d="M9 25h14v5a3 3 0 0 1-3 3h-8a3 3 0 0 1-3-3v-5Z" stroke="#9aabae" stroke-width="1.5" fill="#e8f4f7" fill-opacity=".6"/>
              <path d="M8 11c4-2 12-2 16 0" stroke="#9aabae" stroke-width="1" stroke-linecap="round" opacity=".5"/>
            </svg>
            <span>Ūdens</span>
          </div>
        </div>
        <div class="ip-plate-legend">
          <div class="ip-legend-item">
            <span class="ip-legend-dot" style="background:#6aaa64"></span>
            <div>
              <strong>Dārzeņi un augļi</strong>
              <p>Jo krāsaināki, jo labāk. Vismaz divas trešdaļas — dārzeņi. Kartupelis šeit neieskaitās.</p>
            </div>
          </div>
          <div class="ip-legend-item">
            <span class="ip-legend-dot" style="background:#e8c06d"></span>
            <div>
              <strong>Veseli graudi</strong>
              <p>Brūnie rīsi, griķi, auzas, pilngraudu maize. Baltā maize un baltie rīsi šeit neder.</p>
            </div>
          </div>
          <div class="ip-legend-item">
            <span class="ip-legend-dot" style="background:#84183e"></span>
            <div>
              <strong>Olbaltumvielas</strong>
              <p>Zivis, mājputni, pākšaugi, olas, rieksti. Desas un kūpinājumi — reti.</p>
            </div>
          </div>
          <div class="ip-legend-item">
            <span class="ip-legend-dot" style="background:#b8d4a8"></span>
            <div>
              <strong>Veseli tauki</strong>
              <p>Olīveļļa, avokado, rieksti — kā papildinājums. Tos nedrīkst izlaist.</p>
            </div>
          </div>
        </div>
      </div>

      {/* ─── NotebookLM Video Explainer (pēc 1. sekcijas) ── */}
      {videoId && (
        <VideoEmbed
          videoId={videoId}
          title={videoTitle}
          duration={videoDuration}
          label="Video skaidrojums"
        />
      )}

      {/* ─── NotebookLM Galvenā infografika ───────────────── */}
      {infographicMain && (
        <Infographic
          src={infographicMain}
          alt="Šķīvja metodes vizuāla shēma — proporcijas, piemēri, izvēles"
          width={1080}
          height={1350}
          label="Infografika · saglabā vai izprintē"
          caption="Šī kartīte iederas uz ledusskapja durvīm vai virtuves dēļa — vizuāls atgādinājums katrai ēdienreizei."
        />
      )}

      <!-- ─── Section 2 ─────────────────────────── -->
      <h2 id="proporcijas">Šķīvja proporcijas — ko tas nozīmē praksē</h2>

      <p class="ip-answer">
        Praksē proporcijas nozīmē četras daļas vienā 22–24 cm šķīvī: puse —
        dārzeņi (vismaz divas trešdaļas no tiem ne augļi), ceturtdaļa — veseli
        graudi, ceturtdaļa — olbaltumvielas, plus ēdamkarote veselīgu tauku.
        Nav jāsver — pietiek ar acumēru.
      </p>

      <p>Iedomājies parastu pusdienu šķīvi ar 22–24 cm diametru. Sadalām to četrās daļās:</p>

      <!-- Proporcijas callout cards -->
      <div class="ip-prop-grid">
        <div class="ip-prop-card ip-prop-card--veg">
          <div class="ip-prop-frac">½</div>
          <h3>Dārzeņi un augļi</h3>
          <p>
            Vismaz divas trešdaļas no šīs puses ir dārzeņi, ne augļi. Augļos
            ir fruktoze, kas paaugstina cukura līmeni. Dārzeņos ir šķiedrvielas
            un antioksidanti — un tie cukura līmeni paaugstina daudz mazāk.
          </p>
          <div class="ip-prop-examples">
            <strong>Piemēri:</strong> brokoļi, spināti, paprika, tomāti, burkāni,
            gurķis, zaļie zirņi, cukini, ogas, āboli.
          </div>
          <div class="ip-prop-note">⚠ Kartupelis šajā daļā <em>neieskaitās</em> — augstā glikēmiskā indeksa dēļ.</div>
        </div>

        <div class="ip-prop-card ip-prop-card--grain">
          <div class="ip-prop-frac">¼</div>
          <h3>Veseli graudi</h3>
          <p>
            Svarīgākais vārds — <em>veseli</em>. Baltie graudi ātri paaugstina
            glikozes līmeni asinīs, un sāta sajūta saglabājas tikai īsu brīdi.
            Veseli graudi dod šķiedrvielas un stabilu enerģiju.
          </p>
          <div class="ip-prop-examples">
            <strong>Piemēri:</strong> brūnie rīsi, griķi, auzas, kvinoja,
            pilngraudu maize, bulgurs, mieži.
          </div>
          <div class="ip-prop-note">✗ Baltie rīsi, baltmaize, makaroni no baltajiem miltiem — neder.</div>
        </div>

        <div class="ip-prop-card ip-prop-card--protein">
          <div class="ip-prop-frac">¼</div>
          <h3>Olbaltumvielas</h3>
          <p>
            Olbaltumvielas sāta sajūtu saglabā ilgāk, uztur muskuļus un
            palīdz stabilizēt cukura līmeni pēc ēdienreizes. Zivis — vismaz
            divas reizes nedēļā.
          </p>
          <div class="ip-prop-examples">
            <strong>Piemēri:</strong> zivis, vistas fileja, tītars, olas,
            lēcas, aunazirņi, tofu, tempehs, kefīrs.
          </div>
          <div class="ip-prop-note">↓ Sarkanā gaļa — ne katru dienu. Desas un kūpinājumi — pēc iespējas reti.</div>
        </div>

        <div class="ip-prop-card ip-prop-card--fat">
          <div class="ip-prop-frac">+</div>
          <h3>Veseli tauki</h3>
          <p>
            Tauki palīdz organismam uzņemt vitamīnus A, D, E un K — tie ir
            taukos šķīstoši. Bez taukiem šos vitamīnus no dārzeņiem nevar
            pilnvērtīgi uzņemt. Tāpēc taukus nedrīkst izlaist.
          </p>
          <div class="ip-prop-examples">
            <strong>Piemēri:</strong> olīveļļa (ēdiena gatavošanai),
            avokado, rieksti, sēklas, treknas zivis.
          </div>
          <div class="ip-prop-note">✗ Transtauki, margarīns, daudzkārt lietota cepamā eļļa — izvairies.</div>
        </div>
      </div>

      <!-- ─── Section 3 ─────────────────────────── -->
      <h2 id="ikdienaa">Kā tas izskatās uz šķīvja — reāli piemēri</h2>

      <p>
        Šķīvja metode neprasa, lai katra ēdienreize būtu vienāda. Galvenais —
