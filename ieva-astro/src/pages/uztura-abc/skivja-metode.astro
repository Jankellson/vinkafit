        </div>
      </div>

      <!-- ─── Article prev/next footer ──────────────── -->
      <footer class="ip-nav-footer">
        <!-- LEFT: prev article or back to index -->
        {prevArticle ? (
          <a href={prevArticle.href} class="ip-nav-card ip-nav-card--prev">
            <span class="ip-nav-arrow">←</span>
            <div class="ip-nav-card-text">
              <span class="ip-nav-hint">Iepriekšējā</span>
              <span class="ip-nav-title">{prevArticle.full ?? prevArticle.label}</span>
            </div>
          </a>
        ) : (
          <a href="/uztura-abc" class="ip-nav-card ip-nav-card--back">
            <span class="ip-nav-arrow">←</span>
            <div class="ip-nav-card-text">
              <span class="ip-nav-hint">Visi raksti</span>
              <span class="ip-nav-title">Uztura ABC</span>
            </div>
          </a>
        )}
        <!-- RIGHT: next article -->
        {nextArticle ? (
          <a href={nextArticle.href} class="ip-nav-card ip-nav-card--next">
            <div class="ip-nav-card-text">
              <span class="ip-nav-hint">Nākamā tēma</span>
              <span class="ip-nav-title">{nextArticle.full ?? nextArticle.label}</span>
            </div>
            <span class="ip-nav-arrow">→</span>
          </a>
        ) : (
          <div class="ip-nav-card ip-nav-card--empty">
            <div class="ip-nav-card-text">
              <span class="ip-nav-hint">Tu esi klāt —</span>
              <span class="ip-nav-title">pēdējā tēma</span>
            </div>
          </div>
        )}
      </footer>

    </article><!-- /.ip-content -->
  </div><!-- /.ip-wrap -->

</BaseLayout>

