---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleNav from '../../components/ArticleNav.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';

// ─── NotebookLM-generated multimedia ─────────────────────
// Šie tukšumi tiks aizpildīti, kad NotebookLM video + infografikas gatavas.
// Pagaidām: false = sloti netiek rādīti lapā.
const videoId: string | null      = null;  // YouTube ID, piem. "dQw4w9WgXcQ"
const videoTitle: string          = 'Cukura aizstājēji vienkārši — kurš der tavai situācijai';
const videoDuration: string       = '5:30';

const title = "Cukura aizstājēji: stīvija, eritrols, ksilīts un citi";
const description = "Cukura aizstājēji salīdzinājumā: stīvija, eritrols, ksilīts, aspartāms un sukraloze. Kalorijas, drošās devas un kuram tie neder.";
const canonical = "https://ievajekabsone.lv/uztura-abc/cukura-aizstataji";

const prevArticle = {
  href:  '/uztura-abc/nedelas-edienkarte',
  label: 'Nedēļas ēdienkarte',
  full:  'Nedēļas ēdienkartes plānošana: struktūra un piemēri',
};
const nextArticle = null;

const tocItems = [
  { id: "kas-ir",          label: "Kas ir cukura aizstājēji" },
  { id: "divas-grupas",    label: "Divas grupas — intensīvie saldinātāji un polioli" },
  { id: "stevija",         label: "Stīvija — augu izcelsmes, bez kalorijām" },
  { id: "eritrols-ksilits",label: "Eritrols un ksilīts — cukura spirti" },
  { id: "aspartams-sukraloze", label: "Aspartāms un sukraloze — sintētiskie" },
  { id: "salidzinajums",   label: "Kurš der tavai situācijai" },
  { id: "drosas-devas",    label: "Drošās devas — kas ir ADI" },
  { id: "miti",            label: "Biežākās kļūdas" },
  { id: "faq",             label: "Bieži uzdotie jautājumi" },
];

const faqItems = [
  {
    q: "Vai cukura aizstājēji ir droši lietošanai katru dienu?",
    a: "Ikvienam ES atļautajam saldinātājam EFSA ir noteikusi pieļaujamo dienas devu (ADI) — daudzumu, ko var lietot katru dienu visu mūžu bez riska. Parastā ikdienas lietošanā (tēja, kafija, jogurts) šīs devas praktiski nesasniedz. Izņēmums ir eritrols lielās devās un cilvēki ar fenilketonūriju attiecībā uz aspartāmu — par tiem vairāk rakstā."
  },
  {
    q: "Vai eritrols ir bīstams sirdij?",
    a: "2023. gada pētījums (Cleveland Clinic, Nature Medicine) atrada saistību starp augstu eritrola līmeni asinīs un lielāku sirdslēkmes un insulta risku trīs gadu laikā. Tas ir novērojumu pētījums, ne pierādīts cēloņsakarīgs mehānisms, un EFSA drošības atzinums pagaidām nav mainīts. Ja tev ir sirds un asinsvadu riska faktori, tas ir iemesls ar eritrolu nepārspīlēt, ne pilnībā to izslēgt bez ārsta padoma."
  },
  {
    q: "Kāpēc ksilīts ir bīstams suņiem, bet cilvēkiem ne?",
    a: "Suņu organisms uz ksilītu reaģē pavisam citādi — tas izraisa strauju insulīna izdalīšanos un var novest pie bīstami zema cukura līmeņa un aknu bojājuma jau nelielā devā. Cilvēka organisms ksilītu metabolizē citādi, un tas ir drošs EFSA noteiktās devās. Ja mājās ir suns, žāvējamo gumiju vai konfektes ar ksilītu turi tam nepieejamas."
  },
  {
    q: "Vai stīvija ir labākā izvēle, jo tā ir \"dabīga\"?",
    a: "Dabīga izcelsme pati par sevi nepadara vielu drošāku vai labāku — svarīgas ir devas un pierādījumi, ne vārds uz iepakojuma. Stīvija tiešām ir laba izvēle vairumam: bez kalorijām, izturīga pret karstumu, plaši pētīta. Bet izvēli der balstīt uz konkrēto lietojumu (cepšana, jutīgas zarnas, garšas preference), ne tikai uz \"dabīgs\" uzrakstu."
  },
  {
    q: "Vai aspartāms izraisa vēzi?",
    a: "2023. gadā PVO vēža izpētes aģentūra (IARC) aspartāmu klasificēja kā \"iespējami kancerogēnu\" (2B grupa) — tajā pašā grupā, kur, piemēram, marinēti dārzeņi. Tā ir vājāko pierādījumu kategorija, ne pierādīta cēloņsakarība. Tajā pašā dienā PVO/FAO ekspertu komiteja (JECFA) apstiprināja, ka pašreizējā pieļaujamā deva (40 mg/kg dienā) paliek droša. Cilvēkiem ar fenilketonūriju aspartāms jāizslēdz cita iemesla dēļ — tas satur fenilalanīnu."
  },
  {
    q: "Kurš saldinātājs der cepšanai un vārīšanai?",
    a: "Stīvija, eritrols un sukraloze iztur karstumu bez garšas vai struktūras zuduma. Aspartāms sadalās augstā temperatūrā un zaudē saldumu, tāpēc cepšanai neder — to lieto aukstos vai vieglā siltumā gatavotos ēdienos."
  },
  {
    q: "Vai cukura aizstājēji palīdz zaudēt svaru?",
    a: "Tie samazina kaloriju un cukura daudzumu konkrētajā produktā, kas var palīdzēt kopējā kaloriju bilancē. Bet paši par sevi tie svaru nezaudē — ja saldinātu dzērienu aizstāj ar saldinātu, bet joprojām ēd kaloriju pārpalikumā no citiem avotiem, rezultāta nebūs. Der skatīties uz visu ēdienkarti, ne uz vienu maiņu."
  },
  {
    q: "Vai polioli (eritrols, ksilīts) rada vēdera uzpūšanos?",
    a: "Lielākās devās — jā, jo tie nav pilnībā uzsūcami zarnās. ES regula pieprasa brīdinājumu \"pārmērīga lietošana var izraisīt caureju\" produktiem, kuros polioli veido vairāk par 10% no sastāva. Eritrols šajā ziņā ir maigāks par ksilītu, jo lielākā daļa no tā izdalās neizmainītā veidā, pirms sasniedz resno zarnu."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "url": canonical,
      "datePublished": "2026-09-07",
      "dateModified": "2026-09-07",
      "author": {
        "@type": "Person",
        "name": "Ieva Jēkabsone",
        "@id": "https://ievajekabsone.lv/#ieva",
        "jobTitle": "Uztura konsultante",
        "url": "https://ievajekabsone.lv/par-mani"
      },
      "publisher": { "@type": "Person", "name": "Ieva Jēkabsone", "@id": "https://ievajekabsone.lv/#ieva" },
      "image": "https://ievajekabsone.lv/images/raksti/cukura-aizstataji/cukura-aizstataji-hero.webp",
      "inLanguage": "lv",
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonical }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Sākums", "item": "https://ievajekabsone.lv/" },
        { "@type": "ListItem", "position": 2, "name": "Uztura ABC", "item": "https://ievajekabsone.lv/uztura-abc" },
        { "@type": "ListItem", "position": 3, "name": "Cukura aizstājēji", "item": canonical }
      ]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="/images/raksti/cukura-aizstataji/cukura-aizstataji-og.webp"
  jsonLd={jsonLd}
  activeNav="uztura-abc"
>

  <ArticleNav
    breadcrumbs={[
      { label: 'Sākums',     href: '/' },
      { label: 'Uztura ABC', href: '/uztura-abc' },
      { label: 'Cukura aizstājēji' },
    ]}
    prev={prevArticle}
    next={nextArticle}
  />

  <!-- ══ ARTICLE HERO — ŽURNĀLA VĀKS ═══════════════════════════ -->
  <section class="ip-cover">
    <div class="ip-cover-media">
      <img
        class="ip-cover-img"
        src="/images/raksti/cukura-aizstataji/cukura-aizstataji-hero.webp"
        alt="Mazas bļodiņas ar dažādiem cukura aizstājējiem — baltiem kristāliem un stīvijas lapām — uz gaiša koka galda"
        width="1200" height="630"
        loading="eager"
      />
      <div class="ip-cover-scrim" aria-hidden="true"></div>
      <div class="ip-cover-inner wrap">
        <div class="ip-eyebrow">Uztura pamati · Bloks 08</div>
        <h1>Cukura aizstājēji: kurš <em>tiešām</em> der tev</h1>
        <p class="ip-lede">
          Stīvija, eritrols, ksilīts, aspartāms, sukraloze — visi saucas "cukura aizstājējs",
          bet tie ir pavisam dažādi. Kalorijas, drošās devas un kuram katrs neder.
        </p>
      </div>
    </div>

    <!-- Light strip below: quick answer + stats -->
    <div class="ip-cover-strip">
      <div class="wrap ip-cover-strip-grid">
        <div class="ip-quickans">
          <div class="ip-quickans-label">Īsā atbilde</div>
          <p>
            Visi ES atļautie saldinātāji ir <strong>EFSA izvērtēti un droši</strong> noteiktās devās.
            Izvēle atkarīga no lietojuma: <strong>stīvija un sukraloze</strong> der cepšanai,
            <strong>eritrols</strong> — mīkstākai gremošanai, <strong>aspartāms</strong> — aukstiem dzērieniem.
            Fenilketonūrijas gadījumā aspartāms jāizslēdz.
          </p>
        </div>
        <div class="ip-cover-stats-wrap">
          <div class="ip-stats">
            <div class="ip-stat"><strong>0 kcal</strong><span>gramā — stīvija, eritrols*</span></div>
            <div class="ip-stat"><strong>4</strong><span>mg/kg — stīvijas ADI/dienā*</span></div>
            <div class="ip-stat"><strong>40</strong><span>mg/kg — aspartāma ADI/dienā*</span></div>
            <div class="ip-stat"><strong>&gt;10%</strong><span>polioli = obligāts brīdinājums*</span></div>
          </div>
          <p class="ip-stats-note">* EFSA un ES regula 1169/2011; sk. avotus raksta beigās</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ MAIN LAYOUT: TOC + CONTENT ═══════════════════════════ -->
  <div class="ip-wrap wrap">

    <!-- LEFT: sidebar — Ieva card (static) + sticky TOC -->
    <aside class="ip-sidebar" aria-label="Satura rādītājs">

      <!-- STATIC: Ieva info card — scrolls away -->
      <div class="ip-toc-ieva">
        <img
          src="/assets/images/ieva-portrait.webp"
          alt="Ieva Jēkabsone"
          class="ip-toc-ieva-img"
          width="80" height="80"
        />
        <div class="ip-toc-ieva-name">Ieva Jēkabsone</div>
        <div class="ip-toc-ieva-role">Uztura konsultante</div>
        <p class="ip-toc-ieva-bio">
          Palīdzu saprast, kas uzturā kaitē un kas palīdz.
          Bez stingrām diētām un kaloriju skaitīšanas.
        </p>
        <div class="ip-toc-socials">
          <a href="https://www.instagram.com/ieva.jekabsone/" target="_blank" rel="noopener"
             class="ip-toc-social" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=100089137514285" target="_blank" rel="noopener"
             class="ip-toc-social" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@ieva.jekabson" target="_blank" rel="noopener"
             class="ip-toc-social" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.73a4.85 4.85 0 0 1-1.01-.04z"/>
            </svg>
          </a>
        </div>
        <a href="/pakalpojumi" class="ip-toc-cta">Piesakies konsultācijai →</a>
      </div>

      <!-- STICKY: table of contents only -->
      <div class="ip-toc">
        <div class="ip-toc-inner">
          <div class="ip-toc-label">Saturs</div>
          <nav>
            <ol class="ip-toc-list">
              {tocItems.map(item => (
                <li><a href={`#${item.id}`} class="ip-toc-link">{item.label}</a></li>
              ))}
            </ol>
          </nav>
        </div>
      </div>

    </aside>

    <!-- RIGHT: article content -->
    <article class="ip-content">

      <!-- ─── TL;DR (LLM citation-bait) ──────────── -->
      <div class="ip-tldr">
        <span class="ip-tldr-label">Īsumā</span>
        <p>
          Cukura aizstājēji dalās divās grupās: intensīvie saldinātāji (stīvija, aspartāms, sukraloze —
          gandrīz bez kalorijām, ļoti saldi mazā devā) un cukura spirti jeb polioli (eritrols, ksilīts —
          mazāk kaloriju nekā cukuram, bet lielās devās var radīt vēdera diskomfortu). Visi ES atļautie
          ir EFSA izvērtēti droši noteiktās devās (ADI). Izņēmumi: fenilketonūrijas gadījumā jāizvairās
          no aspartāma, un jaunāki pētījumi rosina piesardzību ar eritrolu cilvēkiem ar sirds un asinsvadu
          riska faktoriem. Ksilīts ir bīstams suņiem.
        </p>
      </div>

      <!-- ─── Key Takeaways ─────────────────────── -->
      <aside class="ip-takeaways" aria-label="Galvenās atziņas">
        <h2>💡 Galvenās atziņas</h2>
        <ul>
          <li>Divas grupas: intensīvie saldinātāji (stīvija, aspartāms, sukraloze) un polioli (eritrols, ksilīts).</li>
          <li>ES regula eritrolam nosaka 0 kcal/g marķējumam; pārējiem poliolu vidēji ap 2,4 kcal/g (ES 1169/2011).</li>
          <li>Stīvijas ADI ir 4 mg/kg dienā, aspartāma — 40 mg/kg, sukralozes — 15 mg/kg (EFSA).</li>
          <li>Polioli virs 10% sastāvā prasa obligātu brīdinājumu par caurejas efektu (ES 1169/2011).</li>
          <li>2023. gada pētījums saistīja augstu eritrola līmeni asinīs ar lielāku sirds un asinsvadu risku (Nature Medicine).</li>
          <li>Aspartāms nedrīkst fenilketonūrijas gadījumā; satur fenilalanīnu.</li>
          <li>Ksilīts ir toksisks suņiem — turi tālāk no mājdzīvniekiem.</li>
        </ul>
      </aside>

      <!-- ─── Section 1 ─────────────────────────── -->
      <h2 id="kas-ir">Kas ir cukura aizstājēji</h2>

      <p class="ip-answer">
        Cukura aizstājēji ir vielas, kas dod saldu garšu ar mazāk kaloriju vai bez tām — atšķirībā
        no parastā cukura, kas dod 4 kcal gramā. Eiropas Savienībā katru saldinātāju pirms atļaušanas
        izvērtē Eiropas Pārtikas nekaitīguma iestāde (EFSA), un tas iepakojumā parādās ar E numuru.
      </p>

      <p>
        Vārds "aizstājējs" maldina domāt, ka tie visi ir vienādi. Patiesībā tā ir liela un dažāda
        grupa — no augu izcelsmes vielām līdz sintētiski ražotām molekulām, un katrai ir sava ķīmija,
        deva un lietošanas gadījums. Tālāk sadalu tos pa grupām, lai skaidrāk.
      </p>

      {/* ─── NotebookLM Video Explainer (pēc 1. sekcijas) ── */}
      {videoId && (
        <VideoEmbed
          videoId={videoId}
          title={videoTitle}
          duration={videoDuration}
          label="Video skaidrojums"
        />
      )}

      <!-- ─── Section 2 ─────────────────────────── -->
      <h2 id="divas-grupas">Divas grupas — intensīvie saldinātāji un polioli</h2>

      <p class="ip-answer">
        <strong>Intensīvie saldinātāji</strong> (stīvija, aspartāms, sukraloze) ir simtiem reižu
        saldāki par cukuru, tāpēc vajag pavisam nedaudz — kalorijas praktiski nulle.
        <strong>Polioli</strong> jeb cukura spirti (eritrols, ksilīts) ir tuvāk cukuram pēc salduma
        un tilpuma, tāpēc der cepšanai tāpat kā cukuru, bet uzsūcas citādi un dod mazāk kaloriju.
      </p>

      <div class="ip-prop-grid">
        <div class="ip-prop-card ip-prop-card--veg">
          <div class="ip-prop-frac">A</div>
          <h3>Intensīvie saldinātāji</h3>
          <p>
            Stīvija, aspartāms, sukraloze. Simtiem reižu saldāki par cukuru — lieto pilienos vai
            mazās tabletēs, ne karotēs.
          </p>
          <div class="ip-prop-examples">
            <strong>Kalorijas:</strong> praktiski nulle, jo deva ir tik maza.
          </div>
        </div>
        <div class="ip-prop-card ip-prop-card--grain">
          <div class="ip-prop-frac">B</div>
          <h3>Polioli (cukura spirti)</h3>
          <p>
            Eritrols, ksilīts. Saldums un tilpums tuvāks cukuram — der aizstāt karote pret karoti
            cepot un vārot.
          </p>
          <div class="ip-prop-examples">
            <strong>Kalorijas:</strong> eritrols — 0 kcal/g marķējumam; ksilīts — ap 2,4 kcal/g.
          </div>
        </div>
      </div>

      <div class="ip-callout ip-callout--tip">
        <div class="ip-callout-icon">💡</div>
        <div>
          <strong>Vienkāršais orientieris:</strong> ja recepte prasa "1 glāzi cukura", meklē poliolu
          (eritrolu vai eritrola-stīvijas maisījumu) — tas aizstājas apjoma ziņā līdzīgi. Ja gribi
          tikai pāris pilienu saldumam tējā, der intensīvais saldinātājs.
        </div>
      </div>

      <!-- ─── Section 3 ─────────────────────────── -->
      <h2 id="stevija">Stīvija — augu izcelsmes, bez kalorijām</h2>

      <p class="ip-answer">
        Stīvija (E960) ir izvilkums no Dienvidamerikas auga <em>Stevia rebaudiana</em> lapām. Tā ir
        bez kalorijām, izturīga pret karstumu un EFSA noteiktā droša deva ir <strong>4 mg uz kg
        ķermeņa svara dienā</strong> (steviola glikozīdu ekvivalentā). 70 kg cilvēkam tas ir aptuveni
        280 mg — daudz vairāk, nekā ikdienā reāli izlieto tējā vai kafijā.
      </p>

      <p>
        Stīvijas mīnuss daudziem ir pēcgarša — nedaudz rūgtena vai lakricai līdzīga, īpaši lielākā
        devā. Tāpēc veikalos bieži pārdod stīvijas un eritrola maisījumus: eritrols dod tilpumu un
        maigāku garšu, stīvija — saldumu.
      </p>

      <!-- Ieva E-E-A-T note -->
      <div class="ieva-note">
        <div class="ieva-note-head">
          <img
            src="/assets/images/ieva-consultant-portrait.webp"
            alt="Ieva Jēkabsone"
            class="ieva-note-avatar ieva-note-avatar--lg"
            width="72" height="72"
          />
          <div>
            <div class="label">Autores piezīme</div>
            <h4>Ieva Jēkabsone</h4>
          </div>
        </div>
        <p>
          Klienti bieži jautā, kurš saldinātājs ir "labākais". Es neatbildu ar vienu vārdu — jautāju
          pretī: vai cepsi, vai zarnas ir jutīgas, vai ir kāds veselības stāvoklis. Stīvija ir laba
          noklusētā izvēle vairumam, bet "dabīgs" pats par sevi nenozīmē "labāks par citiem" — svarīga
          ir deva un tas, vai konkrētais variants der tavai situācijai.
        </p>
        <span class="sig">Ieva</span>
      </div>

      <!-- ─── Section 4 ─────────────────────────── -->
      <h2 id="eritrols-ksilits">Eritrols un ksilīts — cukura spirti</h2>

      <p class="ip-answer">
        Eritrols (E968) un ksilīts (E967) ir polioli — dabā sastopami cukura spirti, ko rūpnieciski
        ražo lielākos daudzumos. ES marķējuma regula eritrolam nosaka <strong>0 kcal/g</strong>, jo
        lielākā daļa izdalās neizmainītā veidā, pirms sasniedz resno zarnu. Ksilītam vidējā vērtība
        ir ap <strong>2,4 kcal/g</strong> — mazāk nekā cukura 4 kcal/g, bet ne nulle.
      </p>

      <p>
        Abi lielākās devās var izraisīt vēdera uzpūšanos, gāzes vai caurejas efektu, jo daļa no tiem
        nesagremojas tievajās zarnās un nonāk resnajā zarnā. Tāpēc ES regula pieprasa brīdinājumu
        "pārmērīga lietošana var izraisīt caurejas efektu" produktiem, kuros polioli veido vairāk par
        10% no sastāva. Eritrols šajā ziņā ir maigāks par ksilītu.
      </p>

      <div class="ip-callout ip-callout--warning">
        <div class="ip-callout-icon">🐕</div>
        <div>
          <strong>Ja mājās ir suns:</strong> ksilīts suņiem ir toksisks jau nelielā devā — izraisa
          strauju insulīna izdalīšanos, bīstami zemu cukura līmeni un var bojāt aknas. Konfektes,
          košļājamā gumija un cepumi ar ksilītu jātur tālāk no mājdzīvniekiem.
        </div>
      </div>

      <div class="ip-callout ip-callout--warning">
        <div class="ip-callout-icon">❤️</div>
        <div>
          <strong>Sirds un asinsvadu riska faktori:</strong> 2023. gada pētījums (Cleveland Clinic,
          <em>Nature Medicine</em>) atrada saistību starp augstu eritrola līmeni asinīs un lielāku
          sirdslēkmes, insulta un nāves risku trīs gadu laikā. Tas ir novērojumu pētījums — ne
          pierādīta cēloņsakarība, un EFSA drošības atzinums pagaidām paliek spēkā. Bet, ja tev ir
          sirds un asinsvadu riska faktori, tas ir iemesls ar eritrolu nepārspīlēt un pārrunāt to ar
          ārstu, ne panika.
        </div>
      </div>

      <!-- ─── Section 5 ─────────────────────────── -->
      <h2 id="aspartams-sukraloze">Aspartāms un sukraloze — sintētiskie</h2>

      <p class="ip-answer">
        Aspartāms (E951) un sukraloze (E955) ir laboratoriski ražoti saldinātāji, katrs ar savu EFSA
        noteikto drošo devu: aspartāmam <strong>40 mg/kg</strong> dienā, sukralozei —
        <strong>15 mg/kg</strong> dienā. Abi ir plaši lietoti bezalkoholiskajos dzērienos un "bez
        cukura" produktos jau vairākas desmitgades.
      </p>

      <p>
        Galvenā praktiskā atšķirība: sukraloze iztur augstu temperatūru, tāpēc der cepšanai un
        vārīšanai. Aspartāms karstumā sadalās un zaudē saldumu — tāpēc to lieto aukstos dzērienos un
        ēdienos, kas negatavojas.
      </p>

      <div class="ip-callout ip-callout--warning">
        <div class="ip-callout-icon">⚠️</div>
        <div>
          <strong>Fenilketonūrija (PKU):</strong> aspartāms satur fenilalanīnu, tāpēc cilvēkiem ar šo
          retu iedzimto vielmaiņas traucējumu tas ir jāizslēdz pilnībā. Tāpēc uz visiem produktiem ar
          aspartāmu ES ir obligāts uzraksts "satur fenilalanīna avotu".
        </div>
      </div>

      <p>
        2023. gadā PVO Starptautiskā vēža izpētes aģentūra (IARC) aspartāmu klasificēja kā "iespējami
        kancerogēnu cilvēkiem" (2B grupa) — tajā pašā, vājāko pierādījumu grupā, kur, piemēram,
        marinēti dārzeņi. Tajā pašā dienā PVO un FAO kopīgā ekspertu komiteja (JECFA) apstiprināja, ka
        pašreizējā drošā deva 40 mg/kg dienā paliek nemainīta. Praktiski: ikdienas lietošanā (dažas
        bundžas dzēriena dienā) šo devu nesasniedz.
      </p>

      <!-- ─── Section 6 ─────────────────────────── -->
      <h2 id="salidzinajums">Kurš der tavai situācijai</h2>

      <p class="ip-answer">
        Nav viena "labākā" saldinātāja — atbilde atkarīga no tā, ko ar to darīsi. Izvēlies savu
        prioritāti zemāk, un tabula parāda, kuri saldinātāji der vislabāk.
      </p>

      <!-- ─── "Kurš der tavai situācijai" interaktīvais rīks ───────────── -->
