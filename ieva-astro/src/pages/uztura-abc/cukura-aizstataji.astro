</style>

<script>
function initArticlePage() {
  // Dinamisks TOC top — zem .nav + article-nav
  function setTocTop() {
    const anav = document.getElementById('article-nav');
    const toc  = document.querySelector<HTMLElement>('.ip-toc');
    if (!toc) return;
    if (anav) {
      const anavTop    = parseFloat(anav.style.top) || 0;
      const anavHeight = anav.offsetHeight;
      toc.style.top = `${anavTop + anavHeight + 12}px`;
    } else {
      const nav = document.querySelector<HTMLElement>('header.nav, .nav');
      toc.style.top = `${(nav ? nav.offsetHeight : 0) + 12}px`;
    }
  }
  setTocTop();
  window.addEventListener('resize', setTocTop, { passive: true });

  // FAQ accordion
  document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-q');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  // Sticky TOC — highlight active section on scroll
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.ip-toc-link');
  const headings = document.querySelectorAll<HTMLElement>('.ip-content h2[id]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
          });
        }
      });
    },
    { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
  );
  headings.forEach(h => observer.observe(h));

  // ─── "Kurš saldinātājs der tev" — priority filter ────
  (function () {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.ip-sweet-btn');
    const rows = document.querySelectorAll<HTMLTableRowElement>('.ip-sweet-table tbody tr');
    const summary = document.getElementById('sweet-summary');
    if (!buttons.length || !rows.length) return;

    const MESSAGES: Record<string, string> = {
      all: 'Izvēlies prioritāti augšā, lai redzētu, kuri saldinātāji der vislabāk.',
      baking: 'Cepšanai un vārīšanai der stīvija, sukraloze un eritrols — visi iztur karstumu. Aspartāms karstumā zaudē saldumu.',
      gut: 'Jutīgām zarnām vislabāk der stīvija, aspartāms vai sukraloze — tie neietekmē gremošanu. Ar eritrolu un ksilītu lielākās devās uzmanies (iespējams caurejas efekts).',
      heart: 'Ja ir sirds un asinsvadu riska faktori, eritrolam der pievērst piesardzību (2023. g. pētījums) — pārrunā to ar ārstu. Stīvija, aspartāms un sukraloze šajā ziņā nav pētītas ar tādu pašu atradni.',
      pku: 'Fenilketonūrijas gadījumā aspartāms jāizslēdz pilnībā — tas satur fenilalanīnu. Pārējie šajā rakstā minētie saldinātāji fenilalanīnu nesatur.',
      pets: 'Ja mājās ir suns, ksilīts ir jāizslēdz pilnībā — tas suņiem ir toksisks jau nelielā devā. Pārējie saldinātāji suņiem nav zināmi tikpat bīstami, bet mājdzīvniekiem cukura aizstājējus vispār nevajag dot.',
    };

    function apply(priority: string) {
      buttons.forEach(b => b.classList.toggle('is-active', b.dataset.priority === priority));

      rows.forEach(row => {
        row.classList.remove('is-dim', 'is-avoid', 'is-caution');
        if (priority === 'all') return;

        const good    = (row.dataset.good    || '').split(' ').filter(Boolean);
        const caution = (row.dataset.caution || '').split(' ').filter(Boolean);
        const avoid   = (row.dataset.avoid   || '').split(' ').filter(Boolean);

        if (avoid.includes(priority)) row.classList.add('is-avoid');
        else if (caution.includes(priority)) row.classList.add('is-caution');
        else if (!good.includes(priority)) row.classList.add('is-dim');
      });

      if (summary) summary.textContent = MESSAGES[priority] || MESSAGES.all;
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => apply(btn.dataset.priority || 'all'));
    });

    apply('all');
  })();
}
document.addEventListener('astro:page-load', initArticlePage);
</script>
