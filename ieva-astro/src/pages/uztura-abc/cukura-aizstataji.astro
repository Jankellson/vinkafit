}
.ip-nav-card:hover { background: var(--cream); border-color: var(--gold); }
.ip-nav-card--prev { border-left: 3px solid var(--gold); }
.ip-nav-card--next { border-left: 3px solid var(--gold); justify-content: space-between; }
