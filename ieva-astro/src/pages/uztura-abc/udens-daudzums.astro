  font-size: 14px; color: rgba(255,248,242,.85);
  background: rgba(255,255,255,.06);
  border-left: 2px solid var(--gold);
  padding: 8px 14px; border-radius: 0 2px 2px 0;
}
.ip-light-note { margin: 16px 0 0; }
.ip-light-note small { color: rgba(255,248,242,.45); font-size: 11.5px; line-height: 1.5; }

/* ─── Related links ──────────────────────────────────── */
.ip-related { background: #fff; padding: 24px 28px; margin: 48px 0 0; border: 1px solid var(--rule); }
.ip-related-label {
  font-family: var(--sans); font-size: 10px;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--ink-soft); margin-bottom: 16px;
}
.ip-related-links { display: flex; flex-direction: column; gap: 2px; }
.ip-related-link {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 0; border-bottom: 1px dashed var(--rule);
  font-size: 15px; color: var(--plum); transition: color .2s;
}
.ip-related-link:last-child { border-bottom: 0; }
.ip-related-link:hover { color: var(--burgundy); }
.ip-related-arrow { color: var(--gold); font-size: 18px; flex-shrink: 0; }

/* ─── Sources ────────────────────────────────────────── */
.ip-sources { margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--rule); }
.ip-sources-label {
  font-family: var(--sans); font-size: 10px;
  letter-spacing: .2em; text-transform: uppercase;
  color: var(--ink-soft); margin-bottom: 16px;
}
.ip-sources-list { padding: 0; margin: 0; list-style: none; counter-reset: sources; }
.ip-sources-list li {
  counter-increment: sources;
  position: relative; padding: 12px 0 12px 40px;
  border-bottom: 1px solid var(--rule);
  font-size: 13.5px; line-height: 1.65; color: var(--ink);
}
.ip-sources-list li::before {
  content: counter(sources, decimal-leading-zero);
  position: absolute; left: 0; top: 12px;
  font-family: var(--serif); font-style: italic;
  font-size: 18px; color: var(--burgundy);
}
.ip-sources-list a { color: var(--burgundy); border-bottom: 1px solid currentColor; }
.ip-sources-updated { font-family: var(--mono); font-size: 11px; color: var(--ink-soft); margin-top: 12px; letter-spacing: .05em; }

/* ─── Prev / Next article footer ─────────────────────── */
.ip-nav-footer {
  display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
  margin-top: 64px; padding-top: 32px; border-top: 2px solid var(--rule);
}
.ip-nav-card {
  display: flex; align-items: center; gap: 16px;
  padding: 24px 22px; background: #fff;
  border: 1px solid var(--rule); text-decoration: none;
  transition: background .15s, border-color .15s; min-width: 0;
}
.ip-nav-card:hover { background: var(--cream); border-color: var(--gold); }
.ip-nav-card--prev { border-left: 3px solid var(--gold); }
.ip-nav-card--next { border-left: 3px solid var(--gold); justify-content: space-between; }
.ip-nav-card--back { border-right: 3px solid var(--rule); }
.ip-nav-arrow { font-size: 22px; color: var(--gold); flex-shrink: 0; transition: transform .2s; }
.ip-nav-card--prev:hover .ip-nav-arrow { transform: translateX(-3px); }
.ip-nav-card--next:hover .ip-nav-arrow { transform: translateX(3px); }
.ip-nav-card-text { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.ip-nav-hint {
  font-family: var(--sans); font-size: 10px;
  letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft);
}
.ip-nav-title {
  font-family: var(--serif); font-size: 15px; line-height: 1.35;
  color: var(--plum);
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  transition: color .15s;
}
.ip-nav-card:hover .ip-nav-title { color: var(--burgundy); }

/* ─── Responsive ─────────────────────────────────────── */
@media (max-width: 860px) {
  .ip-cover-strip-grid { grid-template-columns: 1fr; }
  .ip-cover h1 { max-width: none; }
}
@media (max-width: 1024px) {
  .ip-wrap { grid-template-columns: 1fr; }
  .ip-sidebar { display: none; }
  .ip-tips-grid { grid-template-columns: 1fr; }
  .ip-nav-footer { grid-template-columns: 1fr; gap: 2px; }
}
@media (max-width: 640px) {
  .ip-stats { grid-template-columns: repeat(2, 1fr); max-width: 320px; gap: 12px 0; }
  .ip-stat { padding: 12px 16px 12px 0; margin-right: 16px; }
  .ip-light-inputs { grid-template-columns: 1fr; }
  .ip-nav-card { padding: 18px 16px; gap: 12px; }
  .ip-nav-title { font-size: 14px; }
}
</style>

<script>
function initArticlePage() {
  // Dinamisks TOC top — zem .nav + article-nav
  function setTocTop() {
    const anav = document.getElementById('article-nav');
    const toc  = document.querySelector<HTMLElement>('.ip-toc');
    if (!toc) return;
    if (anav) {
      const anavTop    = parseFloat(anav.style.top) || 0;
      const anavHeight = anav.offsetHeight;
      toc.style.top = `${anavTop + anavHeight + 12}px`;
    } else {
      const nav = document.querySelector<HTMLElement>('header.nav, .nav');
      toc.style.top = `${(nav ? nav.offsetHeight : 0) + 12}px`;
    }
  }
  setTocTop();
  window.addEventListener('resize', setTocTop, { passive: true });

  // FAQ accordion
  document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-q');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  // Sticky TOC — highlight active section on scroll
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.ip-toc-link');
  const headings = document.querySelectorAll<HTMLElement>('.ip-content h2[id]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
          });
        }
      });
    },
    { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
  );
  headings.forEach(h => observer.observe(h));

  // ─── Ūdens kalkulators ───────────────────────────────
  (function () {
    const wEl = document.getElementById('w-weight')   as HTMLInputElement | null;
    const aEl = document.getElementById('w-activity') as HTMLSelectElement | null;
    const totEl = document.getElementById('w-total');
    const glEl  = document.getElementById('w-glasses');
    if (!wEl || !aEl || !totEl || !glEl) return;

    function recalc() {
      const w = Math.min(160, Math.max(40, parseFloat(wEl.value) || 0));
      const act = parseFloat(aEl.value) || 0;
      const totalMl = w * 30 + act;
      const liters = totalMl / 1000;
      const glasses = Math.round(totalMl / 250);
      totEl.textContent = liters.toFixed(1).replace('.', ',');
      glEl.textContent = `≈ ${glasses} glāzes pa 250 ml`;
    }

    wEl.addEventListener('input',  recalc);
    aEl.addEventListener('change', recalc);
    recalc();
  })();
}
document.addEventListener('astro:page-load', initArticlePage);
</script>
