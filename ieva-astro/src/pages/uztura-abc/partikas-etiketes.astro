</style>

<script>
function initArticlePage() {
  // Dinamisks TOC top — zem .nav + article-nav
  function setTocTop() {
    const anav = document.getElementById('article-nav');
    const toc  = document.querySelector<HTMLElement>('.ip-toc');
    if (!toc) return;
    if (anav) {
      const anavTop    = parseFloat(anav.style.top) || 0;
      const anavHeight = anav.offsetHeight;
      toc.style.top = `${anavTop + anavHeight + 12}px`;
    } else {
      const nav = document.querySelector<HTMLElement>('header.nav, .nav');
      toc.style.top = `${(nav ? nav.offsetHeight : 0) + 12}px`;
    }
  }
  setTocTop();
  window.addEventListener('resize', setTocTop, { passive: true });

  // FAQ accordion
  document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-q');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  // Sticky TOC — highlight active section on scroll
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.ip-toc-link');
  const headings = document.querySelectorAll<HTMLElement>('.ip-content h2[id]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
          });
        }
      });
    },
    { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
  );
  headings.forEach(h => observer.observe(h));

  // ─── "Uzturvērtības luksofors" ───────────────────────
  (function () {
    const T: Record<string, { low: number; high: number }> = {
      sugar:  { low: 5,   high: 22.5 },
      satfat: { low: 1.5, high: 5    },
      salt:   { low: 0.3, high: 1.5  },
    };
    const COLOR = { low: '#6aaa64', mid: '#e8a020', high: '#c4526e' };
    const WORD  = { low: 'Maz',     mid: 'Vidēji',  high: 'Daudz' };

    const sugarEl  = document.getElementById('l-sugar')  as HTMLInputElement | null;
    const satfatEl = document.getElementById('l-satfat') as HTMLInputElement | null;
    const saltEl   = document.getElementById('l-salt')   as HTMLInputElement | null;
    if (!sugarEl || !satfatEl || !saltEl) return;

    function zone(key: string, val: number): 'low' | 'mid' | 'high' {
      const t = T[key];
      if (val <= t.low) return 'low';
      if (val > t.high) return 'high';
      return 'mid';
    }

    function paint(key: string, val: number) {
      const z = zone(key, val);
      const dot = document.getElementById(`l-dot-${key}`);
      const verd = document.getElementById(`l-verdict-${key}`);
      if (dot) {
        dot.style.background = COLOR[z];
        dot.style.boxShadow = `0 0 0 4px ${COLOR[z]}33`;
      }
      if (verd) verd.textContent = WORD[z];
      return z;
    }

    function recalc() {
      const zs = paint('sugar',  Math.max(0, parseFloat(sugarEl.value)  || 0));
      const zf = paint('satfat', Math.max(0, parseFloat(satfatEl.value) || 0));
      const zl = paint('salt',   Math.max(0, parseFloat(saltEl.value)   || 0));
      const zones = [zs, zf, zl];

      let msg = '';
      if (zones.includes('high')) {
        msg = 'Vismaz viena vērtība ir sarkanajā zonā. Tas nenozīmē “aizliegts” — tas nozīmē mazākās devās un retāk. Apzināta izvēle, ne aizliegums.';
      } else if (zones.includes('mid')) {
        msg = 'Vidēji. Der ikdienā ar mēru — paskaties arī uz porcijas lielumu un cik bieži šo ēd.';
      } else {
        msg = 'Visas trīs vērtības zaļajā zonā. Uz 100 g šis ir viegls produkts — labs ikdienas pamatam.';
      }
      const sum = document.getElementById('l-summary');
      if (sum) sum.textContent = msg;
    }

    sugarEl.addEventListener('input',  recalc);
    satfatEl.addEventListener('input', recalc);
    saltEl.addEventListener('input',   recalc);
    recalc();
  })();
}
document.addEventListener('astro:page-load', initArticlePage);
</script>
