---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleNav from '../../components/ArticleNav.astro';

const title = "Šķīvja metode ar papildu olbaltumvielām: kāpēc tas mazina izsalkumu";
const description = "Šķīvis ar vairāk olbaltumvielām — puse ogļhidrāti, trešā daļa olbaltumvielas, piektā daļa tauki. Zinātniski pamatota alternatīva, kas mazina izsalkumu.";
const canonical = "https://ievajekabsone.lv/uztura-abc/skivja-metode-papildu-olbaltumvielas";

const prevArticle = null;
const nextArticle = {
  href:  '/uztura-abc/makrouzturvielas',
  label: 'Makrouzturvielas',
  full:  'Makrouzturvielas: olbaltumvielas, tauki un ogļhidrāti — normas un avoti',
};

const tocItems = [
  { id: "kas-ir",         label: "Kas ir šis modelis un no kurienes tas nāk" },
  { id: "proporcijas",    label: "Proporcijas — 50 / 30 / 20" },
  { id: "kapec",          label: "Kāpēc vairāk olbaltumvielu mazina izsalkumu" },
  { id: "salidzinajums",  label: "Salīdzinājums ar parasto šķīvja modeli" },
  { id: "zinatne",        label: "Ko saka zinātne" },
  { id: "faq",            label: "Bieži uzdotie jautājumi" },
];

const faqItems = [
  {
    q: "Vai šis modelis aizstāj šķīvja metodi?",
    a: "Nē, tas ir viens variants ar citu uzsvaru. Parastā šķīvja metode (Hārvardas modelis) skatās uz to, cik VIETAS uz šķīvja aizņem katra produktu grupa. Šis modelis skatās uz to, cik daudz ENERĢIJAS (kaloriju) nāk no katras uzturvielas, un apzināti ceļ olbaltumvielu daļu augstāk, jo tas palīdz justies paēdušam ilgāk."
  },
  {
    q: "Kāpēc tieši 30% olbaltumvielu, ne vairāk?",
    a: "Pētījumā, uz ko šis modelis balstās, mēģināja iet vēl augstāk, bet tas nebija iespējams, nesamazinot ogļhidrātus zem zinātniski pieļaujamā minimuma vai taukus zem tā. 30% olbaltumvielu ar 50% ogļhidrātu un 20% tauku ir robeža, kur visas trīs uzturvielas paliek zinātniski pieļaujamās normās."
  },
  {
    q: "Vai visiem der ēst tik daudz olbaltumvielu?",
    a: "Vairumam veselu pieaugušo — jā. Izņēmums ir nieru slimības: tad olbaltumvielu daudzumu nosaka ārsts, ne vispārīga norma. Ja ir nieru slimība, šis modelis nav piemērots bez ārsta apstiprinājuma."
  },
  {
    q: "Kā praktiski redzēt, cik daudz tas ir uz šķīvja?",
    a: "Vienkāršs orientieris: pusi šķīvja aizņem dārzeņi kopā ar graudiem vai citiem ogļhidrātu avotiem, otru pusi sadali starp lielāku olbaltumvielu porciju (piemēram, plaukstas biezuma gaļas vai zivs gabals) un mazāku tauku daudzumu (piemēram, karote eļļas vai sauja riekstu)."
  },
  {
    q: "Vai šis modelis der svara samazināšanai?",
    a: "Pētījumā, uz ko modelis balstās, dalībnieki ar lielāku olbaltumvielu daļu ēda mazāk pat bez apzinātas ierobežošanas un zaudēja svaru. Tas notika tāpēc, ka olbaltumvielas dod ilgāku sāta sajūtu — nevis kāda maģiska īpašība."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "url": canonical,
      "datePublished": "2026-08-25",
      "dateModified": "2026-08-25",
      "author": {
        "@type": "Person",
        "name": "Ieva Jēkabsone",
        "@id": "https://ievajekabsone.lv/#ieva",
        "jobTitle": "Uztura konsultante",
        "url": "https://ievajekabsone.lv/par-mani"
      },
      "publisher": { "@type": "Person", "name": "Ieva Jēkabsone", "@id": "https://ievajekabsone.lv/#ieva" },
      "inLanguage": "lv",
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonical }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Sākums", "item": "https://ievajekabsone.lv/" },
        { "@type": "ListItem", "position": 2, "name": "Uztura ABC", "item": "https://ievajekabsone.lv/uztura-abc" },
        { "@type": "ListItem", "position": 3, "name": "Šķīvja metode ar papildu olbaltumvielām", "item": canonical }
      ]
    }
  ]
};
