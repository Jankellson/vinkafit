---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleNav from '../../components/ArticleNav.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import Infographic from '../../components/Infographic.astro';

// ─── NotebookLM-generated multimedia ─────────────────────
// Šie tukšumi tiks aizpildīti, kad NotebookLM video + infografikas gatavas.
// Pagaidām: false = sloti netiek rādīti lapā.
const videoId: string | null      = null;  // YouTube ID, piem. "dQw4w9WgXcQ"
const videoTitle: string          = 'Makrouzturvielas — olbaltumvielas, tauki un ogļhidrāti vienkārši';
const videoDuration: string       = '5:30';

const infographicMain: string | null = null;      // /assets/images/makrouzturvielas-infografika-1.webp

const title = "Makrouzturvielas: normas un labākie avoti";
const description = "Makrouzturvielas — olbaltumvielas, tauki un ogļhidrāti. Cik no katras vajag dienā, kalorijas gramā, labākie avoti un kā tās sadalīt šķīvī.";
const canonical = "https://ievajekabsone.lv/uztura-abc/makrouzturvielas";

const prevArticle = {
  href:  '/uztura-abc/skivja-metode',
  label: 'Šķīvja metode',
  full:  'Šķīvja metode: princips, proporcijas un kā to izmantot ikdienā',
};
const nextArticle = {
  href:  '/uztura-abc/partikas-etiketes',
  label: 'Pārtikas etiķetes',
  full:  'Pārtikas etiķetes: kā lasīt sastāvdaļu sarakstu, E vielas un uzturvērtību',
};

const tocItems = [
  { id: "kas-ir",        label: "Kas ir makrouzturvielas" },
  { id: "kalorijas",     label: "Cik kaloriju dod katra makrouzturviela" },
  { id: "olbaltumvielas",label: "Olbaltumvielas — cik vajag un no kā" },
  { id: "tauki",         label: "Tauki — kuri der un kuri ne" },
  { id: "oglhidrati",    label: "Ogļhidrāti — ne ienaidnieks, bet izvēle" },
  { id: "sadalijums",    label: "Kā sadalīt makro vienā dienā" },
  { id: "miti",          label: "Biežākie mīti par makrouzturvielām" },
  { id: "zinatne",       label: "Ko saka zinātne" },
  { id: "faq",           label: "Bieži uzdotie jautājumi" },
];

const faqItems = [
  {
    q: "Vai ogļhidrāti liek pieņemties svarā?",
    a: "Paši par sevi — nē. Svaru paaugstina kaloriju pārpalikums, ne kāda viena makrouzturviela. Problēma parasti nav ogļhidrātos, bet to veidā un daudzumā: baltmaize, saldumi un saldie dzērieni dod daudz kaloriju un maz sāta. Veseli graudi, pākšaugi un dārzeņi to pašu ogļhidrātu uzdevumu pilda daudz labāk."
  },
  {
    q: "Cik olbaltumvielu var uzņemt vienā ēdienreizē?",
    a: "Organisms olbaltumvielas izmanto visā dienas garumā, tāpēc augšējās robežas, pēc kuras tās \"izšķiestos\", nav. Muskuļu atjaunošanai vienā reizē noder aptuveni 20–40 g augstvērtīgu olbaltumvielu (ISSN). Praktiski tas nozīmē: sadali olbaltumvielas pa visām ēdienreizēm, ne tikai vakariņās."
  },
  {
    q: "Vai tauki ir kaitīgi sirdij?",
    a: "Atkarīgs no tauku veida. Nepiesātinātie tauki (olīveļļa, avokado, rieksti, treknas zivis) sirdij ir labvēlīgi. Kaitē transtauki un liels piesātināto tauku daudzums. PVO iesaka piesātinātos taukus turēt zem 10% no dienas kalorijām, bet transtaukus — zem 1%."
  },
  {
    q: "Vai jāskaita makro, lai būtu vesels?",
    a: "Nē. Lielākajai daļai cilvēku pietiek ar šķīvja proporcijām un avotu kvalitāti. Makro skaitīšana noder sportistiem un konkrētiem mērķiem, bet ikdienas veselīgam uzturam tā nav obligāta — pareiza pārtikas izvēle dod gandrīz to pašu rezultātu bez aplikācijas."
  },
  {
    q: "Kuras makrouzturvielas trūkst visbiežāk?",
    a: "Pie manis visbiežāk pietrūkst olbaltumvielu — īpaši brokastīs un launagā. Daudzi dienu sāk ar tīriem ogļhidrātiem (auzu putra ar augļiem, maize ar ievārījumu) un olbaltumvielas atstāj uz vakaru. Tad pa dienu mokas izsalkums un tieksme pēc saldā."
  },
  {
    q: "Vai augu olbaltumvielas ir tikpat labas kā dzīvnieku?",
    a: "Gandrīz. Atsevišķos augos trūkst dažu neaizvietojamo aminoskābju, bet, ja dienā ēd dažādus avotus — pākšaugus, graudus, riekstus, sēklas —, organisms tās savāc kopā. Veģetārā uzturā olbaltumvielu kopējo daudzumu der palielināt par aptuveni 10%, jo augu olbaltumvielas uzsūcas nedaudz sliktāk."
  },
  {
    q: "Cik ogļhidrātu vajag dienā?",
    a: "Ieteicamais diapazons ir 45–60% no dienas kalorijām (EFSA). Pieaugušajam ar ~2000 kcal dienā tas ir aptuveni 225–300 g ogļhidrātu. Galvenais nosacījums: lielākā daļa nāk no veseliem graudiem, dārzeņiem, augļiem un pākšaugiem, ne no cukura."
  },
  {
    q: "Vai bezogļhidrātu diēta ir droša ilgtermiņā?",
    a: "Stingra ogļhidrātu izslēgšana ilgtermiņā vairumam nav vajadzīga un mēdz būt grūti uzturama. Tā var atņemt šķiedrvielas, dažus vitamīnus un labvēlīgās augu vielas. Ja domā par šādu pieeju veselības stāvokļa dēļ (piemēram, diabēts), to dari speciālista uzraudzībā."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "url": canonical,
      "datePublished": "2026-05-29",
      "dateModified": "2026-05-29",
      "author": {
        "@type": "Person",
        "name": "Ieva Jēkabsone",
        "@id": "https://ievajekabsone.lv/#ieva",
        "jobTitle": "Uztura konsultante",
        "url": "https://ievajekabsone.lv/par-mani"
      },
      "publisher": { "@type": "Person", "name": "Ieva Jēkabsone", "@id": "https://ievajekabsone.lv/#ieva" },
      "image": "https://ievajekabsone.lv/images/raksti/makrouzturvielas/makrouzturvielas-hero.webp",
      "inLanguage": "lv",
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonical }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Sākums", "item": "https://ievajekabsone.lv/" },
        { "@type": "ListItem", "position": 2, "name": "Uztura ABC", "item": "https://ievajekabsone.lv/uztura-abc" },
        { "@type": "ListItem", "position": 3, "name": "Makrouzturvielas", "item": canonical }
      ]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="/images/raksti/makrouzturvielas/makrouzturvielas-og.webp"
  jsonLd={jsonLd}
  activeNav="uztura-abc"
>

  <ArticleNav
    breadcrumbs={[
      { label: 'Sākums',     href: '/' },
      { label: 'Uztura ABC', href: '/uztura-abc' },
      { label: 'Makrouzturvielas' },
    ]}
    prev={prevArticle}
    next={nextArticle}
  />

  <!-- ══ ARTICLE HERO — ŽURNĀLA VĀKS ═══════════════════════════ -->
  <section class="ip-cover">
    <div class="ip-cover-media">
      <img
        class="ip-cover-img"
        src="/images/raksti/makrouzturvielas/makrouzturvielas-hero.webp"
        alt="Veseli produkti sagrupēti pēc makrouzturvielām — olbaltumvielas, tauki un ogļhidrāti uz gaiša galda"
        width="1200" height="630"
        loading="eager"
      />
      <div class="ip-cover-scrim" aria-hidden="true"></div>
      <div class="ip-cover-inner wrap">
        <div class="ip-eyebrow">Uztura pamati · Bloks 02</div>
        <h1>Makrouzturvielas: olbaltumvielas, tauki un <em>ogļhidrāti</em></h1>
        <p class="ip-lede">
          Trīs uzturvielas, no kurām organisms ņem enerģiju. Visas vajadzīgas —
          tikai dažādā daudzumā un no dažādiem avotiem. Normas, kalorijas un avoti.
        </p>
      </div>
    </div>

    <!-- Light strip below: quick answer + stats -->
    <div class="ip-cover-strip">
      <div class="wrap ip-cover-strip-grid">
        <div class="ip-quickans">
          <div class="ip-quickans-label">Īsā atbilde</div>
          <p>
            <strong>Olbaltumvielas</strong> atjauno muskuļus. &nbsp;
            <strong>Tauki</strong> uztur hormonus un uzsūc vitamīnus. &nbsp;
            <strong>Ogļhidrāti</strong> dod enerģiju. &nbsp;
            Svarīgs ir avots, ne tikai daudzums.
          </p>
        </div>
        <div class="ip-cover-stats-wrap">
          <div class="ip-stats">
            <div class="ip-stat"><strong>4</strong><span>kcal gramā — olbaltumvielas un ogļhidrāti</span></div>
            <div class="ip-stat"><strong>9</strong><span>kcal gramā — tauki</span></div>
            <div class="ip-stat"><strong>0,83</strong><span>g/kg — olbaltumvielu minimums*</span></div>
            <div class="ip-stat"><strong>45–60%</strong><span>ogļhidrāti no kalorijām*</span></div>
          </div>
          <p class="ip-stats-note">* EFSA references vērtības pieaugušajiem; sk. avotus raksta beigās</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ MAIN LAYOUT: TOC + CONTENT ═══════════════════════════ -->
  <div class="ip-wrap wrap">

    <!-- LEFT: sidebar — Ieva card (static) + sticky TOC -->
    <aside class="ip-sidebar" aria-label="Satura rādītājs">

      <!-- STATIC: Ieva info card — scrolls away -->
      <div class="ip-toc-ieva">
        <img
          src="/assets/images/ieva-portrait.webp"
          alt="Ieva Jēkabsone"
          class="ip-toc-ieva-img"
          width="80" height="80"
        />
        <div class="ip-toc-ieva-name">Ieva Jēkabsone</div>
        <div class="ip-toc-ieva-role">Uztura konsultante</div>
        <p class="ip-toc-ieva-bio">
          Palīdzu saprast, kas uzturā kaitē un kas palīdz.
          Bez stingrām diētām un kaloriju skaitīšanas.
        </p>
        <div class="ip-toc-socials">
          <a href="https://www.instagram.com/ieva.jekabsone/" target="_blank" rel="noopener"
             class="ip-toc-social" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=100089137514285" target="_blank" rel="noopener"
             class="ip-toc-social" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@ieva.jekabson" target="_blank" rel="noopener"
             class="ip-toc-social" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.73a4.85 4.85 0 0 1-1.01-.04z"/>
            </svg>
          </a>
        </div>
        <a href="/pakalpojumi" class="ip-toc-cta">Piesakies konsultācijai →</a>
      </div>

      <!-- STICKY: table of contents only -->
      <div class="ip-toc">
        <div class="ip-toc-inner">
          <div class="ip-toc-label">Saturs</div>
          <nav>
            <ol class="ip-toc-list">
              {tocItems.map(item => (
                <li><a href={`#${item.id}`} class="ip-toc-link">{item.label}</a></li>
              ))}
            </ol>
          </nav>
        </div>
      </div>

    </aside>

    <!-- RIGHT: article content -->
    <article class="ip-content">

      <!-- ─── TL;DR (LLM citation-bait) ──────────── -->
      <div class="ip-tldr">
        <span class="ip-tldr-label">Īsumā</span>
        <p>
          Makrouzturvielas ir olbaltumvielas, tauki un ogļhidrāti — trīs uzturvielas,
          kas dod enerģiju. Olbaltumvielas un ogļhidrāti dod 4 kcal gramā, tauki — 9 kcal.
          Pieaugušajam vajag vismaz 0,83 g olbaltumvielu uz kilogramu svara, 20–35% kaloriju
          no taukiem un 45–60% no ogļhidrātiem. Galvenais ir avotu kvalitāte, ne stingra skaitīšana.
        </p>
      </div>

      <!-- ─── Key Takeaways ─────────────────────── -->
      <aside class="ip-takeaways" aria-label="Galvenās atziņas">
        <h2>💡 Galvenās atziņas</h2>
        <ul>
          <li>Visas trīs makrouzturvielas ir vajadzīgas — neviena nav "sliktā".</li>
          <li>Tauki dod 9 kcal gramā, olbaltumvielas un ogļhidrāti — pa 4 kcal (FAO).</li>
          <li>Olbaltumvielu minimums pieaugušajam ir 0,83 g/kg dienā; aktīviem cilvēkiem 1,2–2,0 g/kg (EFSA, ISSN).</li>
          <li>PVO iesaka piesātinātos taukus turēt zem 10% un brīvo cukuru zem 10% no kalorijām.</li>
          <li>Ieteicamais ogļhidrātu diapazons ir 45–60% no kalorijām (EFSA) — galvenokārt no veseliem graudiem.</li>
          <li>Svaru nosaka kopējās kalorijas, ne kāda viena makrouzturviela.</li>
          <li>Ikdienai pietiek ar šķīvja proporcijām; makro skaitīšana der mērķtiecīgiem sportistiem.</li>
        </ul>
      </aside>

      <!-- ─── Section 1 ─────────────────────────── -->
      <h2 id="kas-ir">Kas ir makrouzturvielas</h2>

      <p class="ip-answer">
        Makrouzturvielas ir trīs uzturvielas, ko organisms vajag lielā daudzumā un
        no kurām iegūst enerģiju: olbaltumvielas, tauki un ogļhidrāti. Tās atšķiras no
        mikrouzturvielām (vitamīniem un minerālvielām), ko vajag pavisam mazās devās.
        Bez makrouzturvielām ķermenis nedarbojas — jautājums ir tikai par to attiecību.
      </p>

      <p>
        Vārds "makro" nozīmē "liels". Tieši tāpēc šīs trīs uzturvielas tā sauc — tās
        veido lielāko daļu no visa, ko apēd. Katrai ir savs uzdevums, un neviena
        neaizstāj otru.
      </p>

      <!-- Macro intro cards (3 makro + alkohols kā kontrasts) -->
      <div class="ip-prop-grid">
        <div class="ip-prop-card ip-prop-card--protein">
          <div class="ip-prop-frac ip-prop-emoji">🍗</div>
          <h3>Olbaltumvielas</h3>
          <p>
            Būvmateriāls. No tām organisms veido un atjauno muskuļus, ādu, matus,
            fermentus un imūnās šūnas. Olbaltumvielas arī ilgi uztur sāta sajūtu.
          </p>
          <div class="ip-prop-examples">
            <strong>Galvenais uzdevums:</strong> audu atjaunošana un sāta sajūta.
          </div>
        </div>

        <div class="ip-prop-card ip-prop-card--fat">
          <div class="ip-prop-frac ip-prop-emoji">🥑</div>
          <h3>Tauki</h3>
          <p>
            Vajadzīgi hormoniem, smadzeņu darbībai un šūnu sienām. Tauki arī palīdz
            uzsūkt vitamīnus A, D, E un K — bez taukiem tos uzņemt nevar.
          </p>
          <div class="ip-prop-examples">
            <strong>Galvenais uzdevums:</strong> hormoni un taukos šķīstošie vitamīni.
          </div>
        </div>

        <div class="ip-prop-card ip-prop-card--grain">
          <div class="ip-prop-frac ip-prop-emoji">🌾</div>
          <h3>Ogļhidrāti</h3>
          <p>
            Ātrākais enerģijas avots. Smadzenes un muskuļi tos izmanto vislabprātāk.
            Veseli ogļhidrāti dod arī šķiedrvielas, kas baro zarnu mikrobiomu.
          </p>
          <div class="ip-prop-examples">
            <strong>Galvenais uzdevums:</strong> enerģija un šķiedrvielas.
          </div>
        </div>

        <div class="ip-prop-card ip-prop-card--alcohol">
          <div class="ip-prop-frac ip-prop-emoji">🍷</div>
          <h3>Alkohols (nav makrouzturviela)</h3>
          <p>
            Alkohols dod 7 kcal gramā — gandrīz tikpat, cik tauki —, bet organismam
            nedod ne būvmateriālu, ne vitamīnus, ne šķiedrvielas. Tās ir tukšās kalorijas.
          </p>
          <div class="ip-prop-examples">
            <strong>Kāpēc te:</strong> tas dod enerģiju, tāpēc to viegli aizmirst, plānojot uzturu.
          </div>
        </div>
      </div>

      {/* ─── NotebookLM Video Explainer (pēc 1. sekcijas) ── */}
      {videoId && (
        <VideoEmbed
          videoId={videoId}
          title={videoTitle}
          duration={videoDuration}
          label="Video skaidrojums"
        />
      )}

      <!-- ─── Section 2 ─────────────────────────── -->
      <h2 id="kalorijas">Cik kaloriju dod katra makrouzturviela</h2>

      <p class="ip-answer">
        Olbaltumvielas un ogļhidrāti dod 4 kilokalorijas gramā, tauki — 9 kilokalorijas
        gramā, bet alkohols — 7 (FAO references vērtības). Tas nozīmē: tauki vienā gramā
        nes vairāk nekā divreiz tik daudz enerģijas kā pārējās. Tāpēc treknus produktus
        sver mazāk, bet kaloriju tie dod daudz.
      </p>

      <p>
        Šos skaitļus 20. gadsimta sākumā noteica ķīmiķis Vilburs Atvoters, un tie joprojām
        ir pamatā uztura marķējumiem visā pasaulē. Šķiedrvielas, lai gan ir ogļhidrāti,
        dod tikai aptuveni 2 kcal gramā, jo organisms tās līdz galam nesašķeļ.
      </p>

      <!-- Bar chart: kcal per gram -->
      <figure class="ip-chart">
        <figcaption class="ip-chart-cap">Enerģija vienā gramā (kcal)</figcaption>
        <svg viewBox="0 0 440 250" role="img" xmlns="http://www.w3.org/2000/svg"
             style="--bar:#84183e; --bar2:#c4526e;">
          <title>Kaloriju daudzums vienā gramā: tauki 9, alkohols 7, olbaltumvielas 4, ogļhidrāti 4, šķiedrvielas 2</title>
          <!-- rows -->
          <g font-family="system-ui, sans-serif" font-size="14">
            <!-- Tauki 9 -->
            <text x="0" y="30" fill="#2A1419">Tauki</text>
            <rect x="120" y="18" width="270" height="20" rx="2" fill="#84183e"/>
            <text x="398" y="33" fill="#2A1419" font-weight="700">9</text>
            <!-- Alkohols 7 -->
            <text x="0" y="70" fill="#2A1419">Alkohols</text>
            <rect x="120" y="58" width="210" height="20" rx="2" fill="#c4526e"/>
            <text x="338" y="73" fill="#2A1419" font-weight="700">7</text>
            <!-- Olbaltumvielas 4 -->
            <text x="0" y="110" fill="#2A1419">Olbaltumvielas</text>
            <rect x="120" y="98" width="120" height="20" rx="2" fill="#6aaa64"/>
            <text x="248" y="113" fill="#2A1419" font-weight="700">4</text>
            <!-- Ogļhidrāti 4 -->
            <text x="0" y="150" fill="#2A1419">Ogļhidrāti</text>
            <rect x="120" y="138" width="120" height="20" rx="2" fill="#e8c06d"/>
            <text x="248" y="153" fill="#2A1419" font-weight="700">4</text>
            <!-- Šķiedrvielas 2 -->
            <text x="0" y="190" fill="#2A1419">Šķiedrvielas</text>
            <rect x="120" y="178" width="60" height="20" rx="2" fill="#b8d4a8"/>
            <text x="188" y="193" fill="#2A1419" font-weight="700">2</text>
          </g>
          <!-- baseline -->
          <line x1="120" y1="210" x2="120" y2="14" stroke="rgba(42,20,25,.18)" stroke-width="1"/>
          <text x="120" y="228" font-family="system-ui, sans-serif" font-size="11" fill="rgba(42,20,25,.55)">0</text>
          <text x="385" y="228" font-family="system-ui, sans-serif" font-size="11" fill="rgba(42,20,25,.55)">9 kcal/g</text>
        </svg>
        <p class="ip-chart-note">Avots: FAO, <em>Food energy — methods of analysis and conversion factors</em> (2003).</p>
      </figure>

      <div class="ip-callout ip-callout--tip">
        <div class="ip-callout-icon">💡</div>
        <div>
          <strong>Ko ar šo iesākt?</strong> Tas nenozīmē, ka tauki jāizvairās. Tas nozīmē,
          ka treknus produktus — eļļu, riekstus, sieru — der mērīt ar acīm: ēdamkarote
          olīveļļas ir ap 120 kcal. Tā nav daudz, bet trīs karotes "neredzot" jau ir 360.
        </div>
      </div>

      <!-- ─── Section 3 ─────────────────────────── -->
      <h2 id="olbaltumvielas">Olbaltumvielas — cik vajag un no kā</h2>

      <p class="ip-answer">
        Veselam pieaugušajam minimums ir 0,83 g olbaltumvielu uz kilogramu svara dienā
        (EFSA). Aktīviem cilvēkiem un tiem, kas vēlas saglabāt muskuļus svara samazināšanas
        laikā, der 1,2–2,0 g/kg (ISSN). 70 kg cilvēkam tas praksē nozīmē aptuveni
        58–140 g dienā, atkarībā no aktivitātes.
      </p>

      <p>
        Olbaltumvielas pie manis ir tā makrouzturviela, kuras visbiežāk pietrūkst —
        īpaši brokastīs. Daudzi dienu sāk ar tīriem ogļhidrātiem un olbaltumvielas
        atstāj uz vakaru. Rezultāts: pa dienu moka izsalkums un tieksme pēc saldā. Vienkāršs
        labojums — pievieno olu, biezpienu vai jogurtu jau no rīta.
      </p>

      <p>
        Praktiski olbaltumvielas der sadalīt pa visām ēdienreizēm, ne sakraut vakariņās.
        Muskuļu atjaunošanai vienā reizē noder ap 20–40 g augstvērtīgu olbaltumvielu (ISSN).
        Tālāk — labi avoti, sakārtoti pēc olbaltumvielu satura.
      </p>

