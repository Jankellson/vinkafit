.ip-macro-viz {
  display: grid; grid-template-columns: 160px 1fr;
  gap: 24px; align-items: center; margin-bottom: 28px;
}
.ip-macro-donut { max-width: 160px; width: 100%; height: auto; display: block; }
.ip-macro-legend { list-style: none; padding: 0; margin: 0; }
.ip-macro-legend li {
