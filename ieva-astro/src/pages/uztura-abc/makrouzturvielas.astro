}
.ip-macro-bar {
  background: rgba(255,255,255,.07);
  border-radius: 3px; padding: 16px 14px;
  border-top: 3px solid transparent;
  display: flex; flex-direction: column; gap: 4px;
}
.ip-macro-bar--prot  { border-top-color: #c4526e; }
.ip-macro-bar--fat   { border-top-color: #6aaa64; }
.ip-macro-bar--carbs { border-top-color: #e8c06d; }
.ip-macro-bar-emoji  { font-size: 18px; margin-bottom: 2px; }
.ip-macro-bar-name   { font-size: 11.5px; color: rgba(255,248,242,.7); font-family: var(--sans); }
