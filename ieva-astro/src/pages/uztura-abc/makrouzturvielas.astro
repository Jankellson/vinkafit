  border-radius: 0 2px 2px 0;
}
.ip-macro-note { margin: 16px 0 0; }
.ip-macro-note small { color: rgba(255,248,242,.45); font-size: 11.5px; line-height: 1.5; }
.ip-macro-note a { color: rgba(235,192,126,.8); border-bottom: 1px solid rgba(235,192,126,.4); }

/* ─── Evidence list ──────────────────────────────────── */
.ip-evidence-list { margin: 24px 0; display: flex; flex-direction: column; gap: 2px; }
.ip-evidence-item { padding: 20px 24px; background: #fff; border: 1px solid var(--rule); border-left: 3px solid var(--gold-soft); box-shadow: 0 3px 14px rgba(60,18,32,.04); }
.ip-evidence-source {
  font-family: var(--sans); font-size: 11px;
  letter-spacing: .15em; text-transform: uppercase;
  color: var(--burgundy); margin-bottom: 8px;
}
.ip-evidence-item p { font-size: 15px; line-height: 1.65; margin: 0; }
.ip-evidence-item a { color: var(--burgundy); border-bottom: 1px solid currentColor; }

/* ─── Related links ──────────────────────────────────── */
.ip-related { background: #fff; padding: 24px 28px; margin: 48px 0 0; border: 1px solid var(--rule); }
.ip-related-label {
  font-family: var(--sans); font-size: 10px;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--ink-soft); margin-bottom: 16px;
}
.ip-related-links { display: flex; flex-direction: column; gap: 2px; }
.ip-related-link {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 0; border-bottom: 1px dashed var(--rule);
  font-size: 15px; color: var(--plum); transition: color .2s;
}
.ip-related-link:last-child { border-bottom: 0; }
.ip-related-link:hover { color: var(--burgundy); }
.ip-related-arrow { color: var(--gold); font-size: 18px; flex-shrink: 0; }

/* ─── Sources ────────────────────────────────────────── */
.ip-sources { margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--rule); }
.ip-sources-label {
  font-family: var(--sans); font-size: 10px;
  letter-spacing: .2em; text-transform: uppercase;
  color: var(--ink-soft); margin-bottom: 16px;
}
.ip-sources-list { padding: 0; margin: 0; list-style: none; counter-reset: sources; }
.ip-sources-list li {
  counter-increment: sources;
  position: relative; padding: 12px 0 12px 40px;
  border-bottom: 1px solid var(--rule);
  font-size: 13.5px; line-height: 1.65; color: var(--ink);
}
.ip-sources-list li::before {
  content: counter(sources, decimal-leading-zero);
  position: absolute; left: 0; top: 12px;
  font-family: var(--serif); font-style: italic;
  font-size: 18px; color: var(--burgundy);
}
.ip-sources-list a { color: var(--burgundy); border-bottom: 1px solid currentColor; }
.ip-sources-updated { font-family: var(--mono); font-size: 11px; color: var(--ink-soft); margin-top: 12px; letter-spacing: .05em; }

/* ─── Prev / Next article footer ─────────────────────── */
.ip-nav-footer {
  display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
  margin-top: 64px; padding-top: 32px; border-top: 2px solid var(--rule);
}
.ip-nav-card {
  display: flex; align-items: center; gap: 16px;
  padding: 24px 22px; background: #fff;
  border: 1px solid var(--rule); text-decoration: none;
  transition: background .15s, border-color .15s; min-width: 0;
}
.ip-nav-card:hover { background: var(--cream); border-color: var(--gold); }
.ip-nav-card--prev { border-left: 3px solid var(--gold); }
.ip-nav-card--next { border-left: 3px solid var(--gold); justify-content: space-between; }
.ip-nav-card--back { border-right: 3px solid var(--rule); }
.ip-nav-arrow { font-size: 22px; color: var(--gold); flex-shrink: 0; transition: transform .2s; }
.ip-nav-card--prev:hover .ip-nav-arrow { transform: translateX(-3px); }
.ip-nav-card--next:hover .ip-nav-arrow { transform: translateX(3px); }
.ip-nav-card-text { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.ip-nav-hint {
  font-family: var(--sans); font-size: 10px;
  letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft);
}
.ip-nav-title {
  font-family: var(--serif); font-size: 15px; line-height: 1.35;
  color: var(--plum);
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  transition: color .15s;
}
.ip-nav-card:hover .ip-nav-title { color: var(--burgundy); }

/* ─── Responsive ─────────────────────────────────────── */
@media (max-width: 860px) {
  .ip-cover-strip-grid { grid-template-columns: 1fr; }
  .ip-cover h1 { max-width: none; }
}
@media (max-width: 1024px) {
  .ip-wrap { grid-template-columns: 1fr; }
  .ip-sidebar { display: none; }
  .ip-prop-grid { grid-template-columns: 1fr; }
  .ip-statcards { grid-template-columns: repeat(2, 1fr); }
  .ip-nav-footer { grid-template-columns: 1fr; gap: 2px; }
  .ip-macro-inputs { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .ip-stats { grid-template-columns: repeat(2, 1fr); max-width: 320px; gap: 12px 0; }
  .ip-stat { padding: 12px 16px 12px 0; margin-right: 16px; }
  .ip-macro-inputs { grid-template-columns: 1fr; }
  .ip-macro-bars { grid-template-columns: 1fr; }
  .ip-macro-viz { grid-template-columns: 1fr; justify-items: center; }
  .ip-statcards { grid-template-columns: 1fr 1fr; }
  .ip-nav-card { padding: 18px 16px; gap: 12px; }
  .ip-nav-title { font-size: 14px; }
}
</style>

<script>
function initArticlePage() {
  // Dinamisks TOC top — zem .nav + article-nav
  function setTocTop() {
    const anav = document.getElementById('article-nav');
    const toc  = document.querySelector<HTMLElement>('.ip-toc');
    if (!toc) return;
    if (anav) {
      const anavTop    = parseFloat(anav.style.top) || 0;
      const anavHeight = anav.offsetHeight;
      toc.style.top = `${anavTop + anavHeight + 12}px`;
    } else {
      const nav = document.querySelector<HTMLElement>('header.nav, .nav');
      toc.style.top = `${(nav ? nav.offsetHeight : 0) + 12}px`;
    }
  }
  setTocTop();
  window.addEventListener('resize', setTocTop, { passive: true });

  // FAQ accordion
  document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-q');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  // Sticky TOC — highlight active section on scroll
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.ip-toc-link');
  const headings = document.querySelectorAll<HTMLElement>('.ip-content h2[id]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
          });
        }
      });
    },
    { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
  );
  headings.forEach(h => observer.observe(h));

  // ─── "Tavs makro plāns" kalkulators ──────────────────
  (function () {
    const CIRC = 2 * Math.PI * 60; // ≈ 376.99
    const ACT: Record<string, number> = { '26': 26, '30': 30, '34': 34, '38': 38 };
    const GOALS: Record<string, { factor: number; protGkg: number; fatPct: number }> = {
      maintain: { factor: 1.00, protGkg: 1.6, fatPct: 0.25 },
      lose:     { factor: 0.80, protGkg: 1.8, fatPct: 0.27 },
      gain:     { factor: 1.10, protGkg: 2.0, fatPct: 0.28 },
      cut:      { factor: 0.85, protGkg: 2.2, fatPct: 0.25 },
    };
    const EXAMPLES: Record<string, string[]> = {
      maintain: [
        'Vistas fileja 150 g — ~46 g olbaltumvielu',
        'Grieķu jogurts 200 g — ~20 g olbaltumvielu',
        'Pākšaugi (lēcas, aunazirņi) 150 g — ~12 g olbaltumvielu',
      ],
      lose: [
        'Biezpiens 200 g — ~24 g olbaltumvielu, maz kaloriju',
        'Lasis 130 g — ~26 g olbaltumvielu + omega-3',
        'Olas 2 gab. — ~13 g olbaltumvielu, ātrs sāts',
      ],
      gain: [
        'Vistas fileja 200 g — ~62 g olbaltumvielu',
        'Auzu putra 80 g + valrieksti 30 g — ~16 g olb. + ogļhidrāti',
        'Lasis 150 g — ~30 g olbaltumvielu + veselīgi tauki',
      ],
      cut: [
        'Vistas fileja 200 g — ~62 g olbaltumvielu, maz tauku',
        'Biezpiens 250 g — ~30 g olbaltumvielu, maz kaloriju',
        'Olas 2 gab. + dārzeņi — ~13 g olb., sātīgas',
      ],
    };

    const wEl = document.getElementById('m-weight') as HTMLInputElement | null;
    const aEl = document.getElementById('m-activity') as HTMLSelectElement | null;
    const gEl = document.getElementById('m-goal') as HTMLSelectElement | null;
    if (!wEl || !aEl || !gEl) return;

    function set(id: string, val: string | number) {
      const el = document.getElementById(id);
      if (el) el.textContent = String(val);
    }

    function setArc(id: string, len: number, offset: number) {
      const el = document.getElementById(id);
      if (!el) return;
      const l = Math.max(0, Math.min(CIRC, len));
      el.setAttribute('stroke-dasharray', `${l.toFixed(1)} ${(CIRC - l).toFixed(1)}`);
      el.setAttribute('stroke-dashoffset', `${(-offset).toFixed(1)}`);
    }

    function recalc() {
      const w = Math.min(250, Math.max(30, parseFloat(wEl.value) || 0));
      const actKcal = ACT[aEl.value] ?? 30;
      const goal = GOALS[gEl.value] ?? GOALS.maintain;
      const examples = EXAMPLES[gEl.value] ?? EXAMPLES.maintain;

      const kcal   = Math.round(w * actKcal * goal.factor);
      const prot   = Math.round(w * goal.protGkg);
      const protKc = prot * 4;
      const fatKc  = Math.round(kcal * goal.fatPct);
      const fat    = Math.round(fatKc / 9);
      const carbKc = Math.max(0, kcal - protKc - fatKc);
      const carbs  = Math.round(carbKc / 4);

      const protPct  = Math.round(protKc / kcal * 100);
      const fatPct   = Math.round(fatKc  / kcal * 100);
      const carbPct  = Math.max(0, 100 - protPct - fatPct);

      set('m-kcal',      kcal.toLocaleString('lv-LV'));
      set('m-prot',      prot);
      set('m-fat',       fat);
      set('m-carbs',     carbs);
      set('m-prot-pct',  protPct + '%');
      set('m-fat-pct',   fatPct  + '%');
      set('m-carbs-pct', carbPct + '%');
      set('m-leg-prot',  protPct + '%');
      set('m-leg-fat',   fatPct  + '%');
      set('m-leg-carbs', carbPct + '%');
      set('m-center-kcal', kcal.toLocaleString('lv-LV'));

      const protLen = protPct / 100 * CIRC;
      const fatLen  = fatPct  / 100 * CIRC;
      const carbLen = CIRC - protLen - fatLen;
      setArc('m-arc-prot',  protLen, 0);
      setArc('m-arc-fat',   fatLen,  protLen);
      setArc('m-arc-carbs', carbLen, protLen + fatLen);

      const listEl = document.getElementById('m-examples-list');
      if (listEl) listEl.innerHTML = examples.map(e => `<li>${e}</li>`).join('');
    }

    wEl.addEventListener('input',  recalc);
    aEl.addEventListener('change', recalc);
    gEl.addEventListener('change', recalc);
    recalc();
  })();
}
document.addEventListener('astro:page-load', initArticlePage);
</script>
