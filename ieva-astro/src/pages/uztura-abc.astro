---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

/**
 * UZTURA ABC — visu rakstu indekss.
 * Kategorijas: vienkāršākās → sarežģītākās (kā grāmatas nodaļas).
 * available: false → "Drīzumā". Mainīt uz true + reālo href kad raksts gatavs.
 */

interface Article {
  title: string;
  href: string;
  available: boolean;
}

interface Category {
  title: string;
  slug: string;
  description: string;
  /** Ievas zīmola ikona: datnes nosaukums + aprakstošs alt teksts. */
  icon: { src: string; alt: string };
  articles: Article[];
}

const ICON = (name: string, alt: string) => ({ src: `/assets/images/ieva-uztura-${name}-ikona.webp`, alt });

const categories: Category[] = [
  {
    slug: 'uztura-pamati',
    title: 'Uztura pamati',
    description: 'Laba vieta, kur sākt — neatkarīgi no tā, vai esi diētu veterāne vai tikai sāc domāt par uzturu. Šķīvja metode, makrouzturvielas, etiķetes, hidratācija, ēdienkartes plānošana. Šīs zināšanas ir stabils pamats — tās nemainās atkarībā no tā, kura mode ir šogad aktuāla.',
    icon: ICON('sabalansets-skivis', 'Šķīvis ar lapām un labības vārpu — uztura pamati: šķīvja metode, makrouzturvielas, etiķetes un ūdens daudzums'),
    articles: [
      { title: 'Šķīvja metode: princips, proporcijas un kā to lietot ikdienā', href: '/uztura-abc/skivja-metode', available: true },
      { title: 'Makrouzturvielas: olbaltumvielas, tauki un ogļhidrāti — normas un avoti', href: '/uztura-abc/makrouzturvielas', available: true },
      { title: 'Pārtikas etiķetes: kā lasīt sastāvdaļu sarakstu, E vielas un uzturvērtību', href: '/uztura-abc/partikas-etiketes', available: true },
      { title: 'Ūdens daudzums dienā: normas, mīti un kā saprast savu vajadzību', href: '/uztura-abc/udens-daudzums', available: true },
      { title: 'Ēšanas biežums: 3 vai 6 reizes dienā — fakti un individuālie faktori', href: '/uztura-abc/esanas-biezums', available: true },
      { title: 'Uztura bagātinātāji: kad tie vajadzīgi, kādi un kādās devās', href: '/uztura-abc/uztura-bogatinatajs', available: true },
      { title: 'Nedēļas ēdienkartes plānošana: struktūra, principi un praktiski piemēri', href: '/uztura-abc/nedelas-edienkarte', available: true },
      { title: 'Cukura aizstājēji: stīvija, eritrols, ksilitols — salīdzinājums un drošas devas', href: '/uztura-abc/cukura-aizstataji', available: false },
      { title: 'Šķiedra uzturā: dienas norma, avoti un ietekme uz gremošanu', href: '/uztura-abc/skiedra-uzturs', available: false },
      { title: 'Omega-3 taukskābes: avoti, norma un kad nepieciešami papildinātāji', href: '/uztura-abc/omega-3', available: false },
    ],
  },
  {
    slug: 'uztura-miti',
    title: 'Uztura mīti un fakti',
    description: 'Katru gadu parādās jauna "revolucionāra" diēta. Detoks, glutens, superfoods, diētas pēc asinsgrupas — lielākā daļa no tā ir mārketings, ne zinātne. Šajā sadaļā izšķiru faktus no mītiem, lai tu vairs netērētu naudu lietām, kas nestrādā.',
    icon: ICON('sezonals-ediena-ritms', 'Saule pār augļu zaru — uztura mīti un fakti: detoks, glutens, keto un superfoods bez mārketinga'),
    articles: [
      { title: 'Tauki un svars: vai piesātinātie tauki tiešām veicina aptaukošanos', href: '/uztura-abc/tauki-svars', available: false },
      { title: 'Detoks diētas: ko zinātne saka un ko aknas dara bez maksas', href: '/uztura-abc/detoks-dietas', available: false },
      { title: 'Glutens un laktoze: nepanesam ība, jutīgums un kam tiešām jāizvairās', href: '/uztura-abc/glutens-laktoze', available: false },
      { title: 'Superfoods: acaí, spirulīna, matcha — uzturvērtība un zinātniskie pierādījumi', href: '/uztura-abc/superfoods', available: false },
      { title: 'Keto un paleo diētas: principi, ieguvumi, riski un pierādījumi', href: '/uztura-abc/keto-paleo', available: false },
      { title: 'Kafija, šokolāde un sarkanvīns: ietekme uz veselību un drošas devas', href: '/uztura-abc/kafija-sokolade-vins', available: false },
      { title: 'Bio un organic pārtika: atšķirības, ieguvumi un vai augstākā cena ir pamatota', href: '/uztura-abc/bio-organic', available: false },
      { title: 'Alkohols un uzturs: ietekme uz svaru, metabolismu un uzturvielām', href: '/uztura-abc/alkohols-uzturs', available: false },
      { title: 'Sāls un veselība: dienas norma, mīti un kad tiešām jāsamazina', href: '/uztura-abc/sals-veseliba', available: false },
    ],
  },
  {
    slug: 'svars-metabolisms',
    title: 'Svars un metabolisms',
    description: 'Yo-yo efekts, metabolisma palēnināšanās, proteīns, gavēšana, hormoni — viss tas, ko reklāmas neizskaidro. Šeit nav "ēd mazāk, kusties vairāk" padomu — ir izskaidrojumi, kāpēc tas nestrādā un kas strādā.',
    icon: ICON('ilgtermina-progress', 'Kāpnes ar augošu stiebru — svars un metabolisms: yo-yo efekts, kaloriju deficīts, hormoni un miegs'),
    articles: [
      { title: 'Yo-yo efekts: cēloņi, mehānisms un kā pārtraukt svara svārstības', href: '/uztura-abc/yo-yo-efekts', available: false },
      { title: 'Metabolisms: kā tas darbojas, kas to palēnina un kā uzlabot', href: '/uztura-abc/metabolisms', available: false },
      { title: 'Proteīna norma dienā: aprēķins, avoti un biežās kļūdas', href: '/uztura-abc/proteina-norma', available: false },
      { title: 'Kaloriju deficīts: princips, ierobežojumi un kāpēc vien tas nestrādā', href: '/uztura-abc/kaloriju-deficits', available: false },
      { title: 'Intermitējoša gavēšana: veidi, ieguvumi, riski un kam neder', href: '/uztura-abc/intermitejosa-gavesana', available: false },
      { title: 'Hormoni un svars: kā hormonālas izmaiņas ietekmē metabolismu', href: '/uztura-abc/hormoni-svars', available: false },
      { title: 'Kortizols un svars: kā hronisks stress ietekmē tauku uzkrāšanos', href: '/uztura-abc/kortizols-svars', available: false },
      { title: 'Miegs un svars: kā miega kvalitāte ietekmē metabolismu un apetīti', href: '/uztura-abc/miegs-svars', available: false },
    ],
  },
  {
    slug: 'uzturs-veseliba',
    title: 'Uzturs un veselība',
    description: 'Uzturs nav tikai svars — tas ietekmē enerģiju, miegu, ādu, garastāvokli un hormonus. Zarnu mikrobioms, imunitāte, emocionālā ēšana, sirds veselība. Bez dramatisma, ar zinātni.',
    icon: ICON('sirds-veseliba', 'Anatomiska sirds ar lapu zariem — uzturs un veselība: zarnu mikrobioms, imunitāte, enerģija un sirds veselība'),
    articles: [
      { title: 'Zarnu mikrobioms: funkcijas, ietekme uz veselību un kā uzlabot ar uzturu', href: '/uztura-abc/zarnu-mikrobioms', available: false },
      { title: 'Emocionālā ēšana: cēloņi, bioloģiskais mehānisms un kā ar to strādāt', href: '/uztura-abc/emocionala-esana', available: false },
      { title: 'Hronisks nogurums un uzturs: cēloņi, deficīti un kā uzlabot enerģiju', href: '/uztura-abc/hronisks-nogurums', available: false },
      { title: 'Uzturs un miegs: kādi produkti uzlabo miega kvalitāti un kādi traucē', href: '/uztura-abc/uzturs-miegs', available: false },
      { title: 'Estrogēns, progesterons un uzturs: kā hormonālas izmaiņas maina uztura vajadzības', href: '/uztura-abc/estrogens-uzturs', available: false },
      { title: 'Uzturs menopauzes laikā: simptomi, ieteikumi un kādi produkti palīdz', href: '/uztura-abc/menopauze-uzturs', available: false },
      { title: 'Ādas veselība un uzturs: kādi produkti uzlabo ādas stāvokli no iekšpuses', href: '/uztura-abc/ada-uzturs', available: false },
      { title: 'Aknu veselība un uzturs: kā atbalstīt aknas ikdienā bez detoksiem', href: '/uztura-abc/aknu-veseliba', available: false },
      { title: 'B12 deficīts: simptomi, cēloņi, norma analīzēs un kā novērst', href: '/uztura-abc/b12-deficits', available: false },
      { title: 'Probiotika un prebiotika: atšķirības, avoti un kā lietot efektīvi', href: '/uztura-abc/probiotika-prebiotika', available: false },
      { title: 'Imunitāte un uzturs: kādi produkti un vielas atbalsta imūnsistēmu', href: '/uztura-abc/imunitates-uzturs', available: false },
      { title: 'Sirds veselība un uzturs: kādi produkti aizsargā un kādi kaitē', href: '/uztura-abc/sirds-veseliba', available: false },
    ],
  },
  {
    slug: 'asinsanalyzes',
    title: 'Asinsanalīzes un uzturs',
    description: 'Ārsts saka "viss normāli" — bet tu jūties slikti. Bieži vien atbilde ir asinsanalīzēs, ko ārsts nepaskaidro. Šeit mācīšu lasīt savus rādītājus, saprast, kas ir "normāli" un kas — "optimāli", un kā uzturs šo mainīt.',
    icon: ICON('asinsanalizu-konteksts', 'Asinsanalīžu mēģene ar auga zariņu — asinsanalīzes un uzturs: holesterīns, feritīns, D vitamīns un vairogdziedzeris'),
    articles: [
      { title: 'Paaugstināts holesterīns: normas, veidi un kā uzturs ietekmē rādītājus', href: '/uztura-abc/holesterins', available: false },
      { title: 'Insulīna rezistence: simptomi, cēloņi, analīzes un uztura risinājumi', href: '/uztura-abc/insulina-rezistence', available: false },
      { title: 'Feritīns: norma analīzēs, zema feritīna simptomi un kā celt dzelzs ar uzturu', href: '/uztura-abc/feritins', available: false },
      { title: 'D vitamīna deficīts: simptomi, norma analīzēs un kā novērst', href: '/uztura-abc/d-vitamins', available: false },
      { title: 'Vairogdziedzera analīzes: TSH, T3, T4 — normas un ko tās nozīmē', href: '/uztura-abc/vairogdziedzeris-analize', available: false },
      { title: 'HbA1c: norma, ko nozīmē paaugstināts rādītājs un kā uzturs to ietekmē', href: '/uztura-abc/hba1c', available: false },
      { title: 'CRP un iekaisuma marķieri: norma, cēloņi un kā uzturs samazina iekaisumu', href: '/uztura-abc/crp-iekaisms', available: false },
      { title: 'Hormonu analīzes: kādas veikt, ko skatīties un ko prasīt ārstam', href: '/uztura-abc/hormonu-analize', available: false },
      { title: 'Magnija deficīts: simptomi, norma analīzēs un labākie avoti uzturā', href: '/uztura-abc/magnijs-deficits', available: false },
      { title: 'Normāli vs optimāli rādītāji: kāpēc "robežās" nenozīmē "labi"', href: '/uztura-abc/normali-vs-optimali', available: false },
      { title: 'Folāts (B9): norma analīzēs, deficīta simptomi un avoti uzturā', href: '/uztura-abc/folats-b9', available: false },
      { title: 'Homocisteīns: ko nozīmē paaugstināts rādītājs un kā to samazināt', href: '/uztura-abc/homocisteins', available: false },
    ],
  },
  {
    slug: 'vegana-uzturs',
    title: 'Vegāna un veģetāriešu uzturs',
    description: 'Augu valsts uzturs var būt pilnvērtīgs — ja zini, ko kontrolēt. Šajā sadaļā — deficīti, olbaltumvielu avoti, vajadzīgie papildinātāji un asinsanalīzes, kas jāpārbauda regulāri.',
    icon: ICON('sezonas-darzeni', 'Burkāns, tomāts un garšaugi — vegāna un veģetāriešu uzturs: deficīti, olbaltumvielu avoti un uztura bagātinātāji'),
    articles: [
      { title: 'Vegāna uzturs: kādi deficīti draud un kā tos novērst', href: '/uztura-abc/vegana-uzturs', available: false },
      { title: 'Proteīns veģetāriešu uzturā: avoti, norma un kombinēšana', href: '/uztura-abc/vegetarietis-proteins', available: false },
      { title: 'Uztura bagātinātāji vegāniem: B12, D vitamīns, omega-3 un dzelzs', href: '/uztura-abc/vegana-bogatinatajs', available: false },
      { title: 'Asinsanalīzes vegāniem: kādus rādītājus regulāri pārbaudīt', href: '/uztura-abc/vegana-asinsanalize', available: false },
    ],
  },
];

const totalArticles = categories.reduce((sum, c) => sum + c.articles.length, 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Uztura ABC — Zināšanu bāze",
  "url": "https://ievajekabsone.lv/uztura-abc",
  "description": "Uztura zināšanu bāze latviski — no pamatiem līdz asinsanalīzēm. Bez maksas.",
  "author": { "@type": "Person", "@id": "https://ievajekabsone.lv/#ieva" },
  "inLanguage": "lv",
};
---

<BaseLayout
  title="Uztura ABC — bezmaksas zināšanu bāze | Ieva Jēkabsone"
  description={`Uztura zināšanu bāze latviski: pamati, svars un metabolisms, veselība, asinsanalīzes. ${totalArticles} raksti loģiskā secībā. Bez maksas.`}
  canonical="https://ievajekabsone.lv/uztura-abc"
  jsonLd={jsonLd}
  activeNav="uztura-abc"
>

  <Breadcrumbs items={[
    { label: 'Sākums', href: '/' },
    { label: 'Uztura ABC' }
  ]} />

  <!-- HERO -->
  <section class="phero">
    <div class="wrap phero-grid">

      <div class="phero-text">
        <div class="eyebrow">Uztura ABC</div>
        <h1>Viss, ko gribi zināt par uzturu, <em>vienā vietā.</em></h1>
        <p class="lede">
          {totalArticles} raksti. 6 tēmas. Loģiska secība no uztura pamatiem līdz
          asinsanalīžu izpratnei — lasi kā grāmatu vai atver tieši to tēmu, kas tevi
          šobrīd uztrauc.
        </p>

        <ul class="phero-facts">
          <li><strong>{categories.length}</strong><span>nodaļas loģiskā secībā</span></li>
          <li><strong>{totalArticles}</strong><span>raksti ar atsaucēm uz avotiem</span></li>
          <li><strong>0 €</strong><span>bez maksas, bez reģistrēšanās</span></li>
        </ul>
      </div>

      <figure class="phero-photo" style="--obj: center 45%;">
        <img
          src="/assets/images/ieva-jekabsone-uztura-pieraksti-kafejnica.webp"
          alt="Ieva Jēkabsone kafejnīcā raksta uztura piezīmes blociņā — Uztura ABC ir viņas darba zināšanu bāze, pierakstīta latviski"
          width="1023" height="1537" loading="eager"
        />
        <figcaption><span class="script">Ieva</span> Pamati, kas nemainās katru sezonu.</figcaption>
      </figure>

    </div>
  </section>

  <!-- ARTICLE INDEX — full-width strips -->
  <div class="abc-index">
    {categories.map((cat, catIdx) => (
      <div class={`abc-strip ${catIdx % 2 === 0 ? 'abc-strip--ivory' : 'abc-strip--cream'}`} id={cat.slug}>
        <div class="wrap abc-strip-inner">

          <!-- LEFT: category info -->
          <div class="abc-cat-left">
            <div class="abc-cat-num">0{catIdx + 1}</div>
            <div class="abc-cat-icon">
              <img src={cat.icon.src} alt={cat.icon.alt} width="200" height="200" loading="lazy" />
            </div>
            <h2 class="abc-cat-title">{cat.title}</h2>
            <p class="abc-cat-desc">{cat.description}</p>
            <div class="abc-cat-count">{cat.articles.length} raksti</div>
          </div>

          <!-- RIGHT: article list -->
          <ul class="abc-article-list" aria-label={`Raksti: ${cat.title}`}>
            {cat.articles.map((art) => (
              <li class="abc-article-item">
                {art.available ? (
                  <a href={art.href} class="abc-article-link">
                    <span>{art.title}</span>
                    <span class="abc-arrow" aria-hidden="true">→</span>
                  </a>
                ) : (
                  <div class="abc-article-pending">
                    <span class="abc-article-title-muted">{art.title}</span>
                  </div>
                )}
              </li>
            ))}
          </ul>

        </div>
      </div>
    ))}
  </div>

  <!-- ══ SEO / ABOUT THIS RESOURCE ═══════════════════════════ -->
  <section class="abc-seo">
    <div class="wrap abc-seo-inner">

      <div class="eyebrow">Par šo zināšanu bāzi</div>
      <h2 class="abc-seo-title">Uztura zināšanas latviski — bez modes diētām un brīnumsolījumiem</h2>

      <div class="abc-seo-body">
        <p>
          Uztura ABC ir bezmaksas zināšanu bāze latviešu valodā, kurā soli pa solim izskaidroti
          uztura pamati — no šķīvja metodes un makrouzturvielām līdz asinsanalīžu izpratnei. Katrs
          raksts ir veidots kā mācību materiāls: ar skaidru atbildi sākumā, konkrētiem piemēriem,
          devām un atsaucēm uz primārajiem avotiem (PVO, EFSA, NIH, Hārvarda). Mērķis ir vienkāršs —
          lai tu saproti, kas uzturā tiešām palīdz un kas ir tikai mārketings.
        </p>

        <h3>Kam šī lapa ir domāta</h3>
        <p>
          Šī zināšanu bāze ir domāta ikvienam, kurš grib saprast uzturu bez stingrām diētām un bez
          maksas. Tā noder, ja vēlies zaudēt vai noturēt svaru, sakārtot ēšanas paradumus, izprast savas
          asinsanalīzes vai vienkārši atšķirt faktus no interneta mītiem. Saturs ir neitrāls un derīgs
          plašam cilvēku lokam — sievietēm un vīriešiem, sportistiem, vegāniem un ģimenēm. Tev nav
          jābūt iepriekšējām zināšanām: raksti sakārtoti no vienkāršākā uz sarežģītāko, tāpēc vari sākt
          no paša sākuma vai atvērt tieši to tēmu, kas tevi šobrīd uztrauc.
        </p>

        <h3>Ko šeit atradīsi</h3>
        <p>
          Saturs ir sadalīts sešās tēmās: <strong>uztura pamati</strong> (šķīvja metode,
          makrouzturvielas, etiķetes, ūdens, ēdienreižu biežums, uztura bagātinātāji, ēdienkartes
          plānošana), <strong>uztura mīti un fakti</strong> (detokss, glutens, keto, superfoods),
          <strong>svars un metabolisms</strong> (yo-yo efekts, kaloriju deficīts, hormoni, miegs),
          <strong>uzturs un veselība</strong> (zarnu mikrobioms, emocionālā ēšana, imunitāte),
          <strong>asinsanalīzes</strong> (holesterīns, feritīns, D vitamīns, vairogdziedzeris) un
          <strong>vegāna uzturs</strong>. Katra tēma aug pakāpeniski, un raksti ir savstarpēji saistīti,
          lai tu varētu sekot dabīgam zināšanu pavedienam.
        </p>

        <h3>Kā vislabāk to lietot</h3>
        <p>
          Ja tikai sāc, izlasi vispirms <a href="/uztura-abc/skivja-metode">šķīvja metodi</a> un
          <a href="/uztura-abc/makrouzturvielas">makrouzturvielas</a> — tās ir pamats, uz kura balstās
          viss pārējais. Pēc tam vari pāriet pie tēmas, kas tev aktuāla, piemēram,
          <a href="/uztura-abc/nedelas-edienkarte">nedēļas ēdienkartes plānošanas</a> vai
          <a href="/uztura-abc/uztura-bogatinatajs">uztura bagātinātājiem</a>. Katra raksta beigās ir
          saistīto tēmu saraksts, kas palīdz turpināt. Šīs zināšanas nemainās atkarībā no tā, kura diēta
          ir šogad modē — tās ir stabils pamats, uz kura veidot savus paradumus.
        </p>

        <h3>Kāpēc šim saturam var uzticēties</h3>
        <p>
          Visus rakstus veido <a href="/par-mani">Ieva Jēkabsone</a>, uztura konsultante, kura
          ikdienā strādā ar reāliem klientiem. Pieeja ir zinātnē balstīta un pret modes diētām: katrs
          skaitlis un apgalvojums ir pārbaudīts un papildināts ar atsauci uz primāro avotu. Šeit nav
          brīnumdiētu, aizliegumu sarakstu vai ātru risinājumu solījumu — ir godīga, praktiska
          informācija, ko vari pielietot savā dzīvē. Ja saproti, ka vajag arī individuālu pieeju savai
          situācijai, vari <a href="/pakalpojumi">pieteikties konsultācijai</a>.
        </p>
      </div>

    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="abc-newsletter">
    <div class="wrap">
      <div class="abc-newsletter-inner">
        <div>
          <h3>Uzzini, kad parādās jauns raksts.</h3>
          <p>Publicēju pakāpeniski — bez steigas, bet regulāri. Pievienojies newsletter un lasi pirmā.</p>
        </div>
        <a href="/#start" class="btn btn-primary">Pievienoties <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="trust-signal">
    <div class="wrap trust-signal-inner">
      <div class="eyebrow center">Kāpēc bez maksas</div>
