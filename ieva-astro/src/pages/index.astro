---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://ievajekabsone.lv/#ieva",
      "name": "Ieva Jēkabsone",
      "jobTitle": "Uztura konsultante",
      "description": "ITEC sertificēta uztura konsultante (nutriologs) Latvijā. Individuāla, zinātnē balstīta pieeja uzturam: pielāgošana, nevis aizliegumi. Palīdz saprast arī asinsanalīžu un uztura saistību.",
      "url": "https://ievajekabsone.lv/",
      "email": "info@ievajekabsone.lv",
      "sameAs": [
        "https://www.instagram.com/ieva.jekabsone/",
        "https://www.facebook.com/profile.php?id=100089137514285",
        "https://www.tiktok.com/@ieva.jekabson"
      ],
      "image": "https://ievajekabsone.lv/assets/images/ieva-consultant-portrait.webp",
      "knowsLanguage": ["lv", "ru", "en"]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://ievajekabsone.lv/#business",
      "name": "Ieva Jēkabsone — Uztura konsultācijas",
      "description": "Individuālas uztura konsultācijas un plāni tiešsaistē latviešu un krievu valodā. ITEC sertificēta uztura konsultante Latvijā.",
      "url": "https://ievajekabsone.lv/",
      "email": "info@ievajekabsone.lv",
      "founder": { "@id": "https://ievajekabsone.lv/#ieva" },
      "areaServed": ["Rīga", "Latvija"],
      "priceRange": "49 €–1500 €",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Rīga",
        "addressCountry": "LV"
      },
      "sameAs": [
        "https://www.instagram.com/ieva.jekabsone/",
        "https://www.facebook.com/profile.php?id=100089137514285"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Vai šis ir kārtējais PDF plāns ar pārtikas tabulu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nē. Mans darbs sākas individuāli ar tevi — tavu situāciju, paradumiem un, ja vajag, arī analīžu rādītājiem. Gatava tabula to nevar aizstāt."
          }
        },
        {
          "@type": "Question",
          "name": "Vai konsultācija notiek tiešsaistē vai klātienē?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Parasti tiešsaistē — video zvanā, latviešu vai krievu valodā. Ja vēlies tikties klātienē, arī tā ir iespējams."
          }
        },
        {
          "@type": "Question",
          "name": "Vai man būs jāatsakās no saviem mīļākajiem ēdieniem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nē. Es strādāju ar pielāgošanu, ne aizliegumiem. Mīļākajiem ēdieniem meklējam vietu tavā ikdienā — citā daudzumā vai citā brīdī."
          }
        },
        {
          "@type": "Question",
          "name": "Man ir veselības problēma — vai tu vari palīdzēt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pastāsti savu situāciju, un es godīgi pateikšu, vai varu palīdzēt. Ja nevaru, ieteikšu, pie kāda speciālista vērsties. Es neesmu ārste — diagnozes nenoteikšu un medikamentus nenozīmēšu."
          }
        },
        {
          "@type": "Question",
          "name": "Kā notiek darbs ar asinsanalīzēm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tu atsūti savus rezultātus, un mēs pārrunājam, kā uzturs un ikdienas paradumi var būt saistīti ar laboratorijas rādītājiem. To izmantoju, lai sagatavotu tev pielāgotus uztura ieteikumus. Diagnozes noteikšana, ārstēšana un medikamentu nozīmēšana šajā pakalpojumā neietilpst."
          }
        },
        {
          "@type": "Question",
          "name": "Neesmu pārliecināts, vai man vispār vajag konsultāciju.",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tieši tam ir sākuma konsultācija par 49 €. Pastāsti savu situāciju, un kopā noskaidrojam, vai un kā varu palīdzēt. Ja 24 stundu laikā izvēlies programmu, šo summu ieskaitu tās cenā."
          }
        },
        {
          "@type": "Question",
          "name": "Vai varu atcelt vai pārcelt konsultāciju?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jā, ja paziņo vismaz 24 stundas iepriekš. Pārcelšana iespējama vienu reizi bez maksas. Vēlāka atcelšana vai neierašanās netiek atmaksāta."
          }
        },
        {
          "@type": "Question",
          "name": "Vai konsultācija der grūtniecēm vai barojošām māmiņām?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Grūtniecēm — tikai ar ārsta atļauju, un konsultācija ir informatīva, ne medicīniska. Barojošām māmiņām — jā, ar individuālu pieeju, kas ņem vērā papildu vajadzības."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Ieva Jēkabsone — Uztura konsultante Latvijā"
  description="Individuāla uztura sistēma, kas māca saprast savu ķermeni — ne kārtējā diēta. Uztura konsultantes (nutriologa) konsultācijas tiešsaistē latviešu un krievu valodā ar Ievu Jēkabsoni."
  canonical="https://ievajekabsone.lv/"
  jsonLd={jsonLd}
  activeNav="sakums"
>

  <!-- ═══ 1 · HERO ═══ -->
  <section class="hero">
    <div class="wrap hero-grid">

      <div class="hero-text">
        <div class="hero-meta">
          <span class="dot"></span>
          <span>Uztura konsultante</span>
        </div>
        <h1 class="hero-h1">
          Kļūsti par sava ķermeņa <em>ekspertu.</em>
        </h1>
        <p class="hero-tagline">Uztura konsultācijas, kas māca saprast, nevis izpildīt.</p>

        <p class="lede">
          Individuāls darbs ar tavu ķermeni, paradumiem un analīžu rādītājiem.
        </p>

        <div class="hero-ctas">
          <a href="/pakalpojumi/sakuma-konsultacija" class="btn btn-primary">
            Pieteikt sākuma konsultāciju — 49 € <span class="arrow">→</span>
          </a>
          <a href="#start" class="btn-link">Iegūsti bezmaksas ceļvedi ↓</a>
        </div>
      </div>

      <div class="hero-portrait-wrap">
        <img
          src="/assets/images/ieva-consultant-portrait.webp"
          alt="Ieva Jēkabsone — uztura konsultante"
          width="400"
          height="533"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-tag">
          <span class="script">Ieva</span>
          Tavs atbalsts veselīga uztura ceļā.
        </div>
      </div>

    </div>
  </section>

  <!-- ═══ 2 · TRUST STRIP ═══ -->
  <div class="trust-strip">
    <div class="wrap trust-strip-inner">
      <div class="trust-item">
        <span class="trust-big">ITEC</span>
        <span class="trust-cap">Sertificēta uztura konsultante</span>
      </div>
      <div class="trust-sep"></div>
      <div class="trust-item">
        <span class="trust-big">50+</span>
        <span class="trust-cap">Klienti individuālajā darbā</span>
      </div>
      <div class="trust-sep"></div>
      <div class="trust-item">
        <span class="trust-big">30–90</span>
        <span class="trust-cap">Dienu programmas, ne vienreizējs plāns</span>
      </div>
      <div class="trust-sep"></div>
      <div class="trust-item">
        <span class="trust-big">LV · RU</span>
        <span class="trust-cap">Tiešsaistē vai klātienē</span>
      </div>
    </div>
  </div>

  <!-- ═══ 3 · STAKES ═══ -->
  <section class="stakes">
    <div class="wrap">
      <div class="stakes-grid">

        <div class="stakes-left">
          <div class="eyebrow">Skan pazīstami?</div>
          <h2 class="section-title" style="margin-top:20px;">Izmēģināts ir viss, bet tu tomēr esi <em>tur, kur sāki.</em></h2>
          <p class="lede" style="margin-top:24px;">
            Gribasspēks vien nenosaka rezultātu. Kopā paskatīsimies arī uz tava ķermeņa
            vajadzībām, deficītiem, ikdienas paradumiem un analīžu rādītājiem — tur parasti
            atrodas tas, kas pietrūka.
          </p>
        </div>

        <figure class="stakes-photo">
          <img
            src="/assets/images/ieva-vakarinas-majas-virtuve.webp"
            alt="Ieva Jēkabsone vakarā mājas virtuvē liek zaļumus uz salātu bļodas — parasta diena, kurā ēdiens vairs nav cīņa"
            width="929" height="1692" loading="lazy"
          />
        </figure>

        <ul class="stakes-list">
          <li class="stake">
            <span class="stake-num">/01</span>
            <div class="stake-body"><p><strong>Svars atgriežas</strong> pēc katras diētas — jo nekas nav mainījies pamatā.</p></div>
          </li>
          <li class="stake">
            <span class="stake-num">/02</span>
            <div class="stake-body"><p><strong>Ārsts saka „ēdiet veselīgāk”</strong>, bet nepaskaidro, kāpēc tavi asins rādītāji ir tieši tādi.</p></div>
          </li>
          <li class="stake">
            <span class="stake-num">/03</span>
            <div class="stake-body"><p><strong>Diētas nomaina cita citu</strong> — kaloriju skaitīšana, badošanās, keto — bez paliekoša rezultāta.</p></div>
          </li>
          <li class="stake">
            <span class="stake-num">/04</span>
            <div class="stake-body"><p><strong>Ēdiens kļuvis par ienaidnieku</strong> — un pēc katras maltītes seko vainas sajūta.</p></div>
          </li>
        </ul>

      </div>
    </div>
  </section>

  <!-- ═══ 4 · VALUE PROPOSITION ═══ -->
  <section>
    <div class="wrap">
      <div class="section-head" style="max-width:720px;">
        <div class="eyebrow">Ar manu sistēmu</div>
        <h2 class="section-title" style="margin-top:20px;">Iegūsti „instrukciju”, kas domāta tieši <em>tavam ķermenim.</em></h2>
      </div>

      <div class="value-grid">
        <div class="value-card">
          <span class="value-kicker">01</span>
          <span class="value-icon">
            <img src="/assets/images/ieva-uztura-asinsanalizu-konteksts-ikona.webp" alt="Asinsanalīžu mēģene ar auga zariņu — Ieva Jēkabsone izvērtē analīžu rādītājus uztura kontekstā, lai saprastu, kāpēc ķermenis reaģē tieši tā" width="200" height="200" loading="lazy" />
          </span>
          <h3>Izpratne, kāpēc</h3>
          <p>Ne minējumi, bet fakti — kāpēc svars neatkāpjas, kāpēc enerģija ir zema un ko par to stāsta tavi analīžu rādītāji.</p>
        </div>
        <div class="value-card">
          <span class="value-kicker">02</span>
          <span class="value-icon">
            <img src="/assets/images/ieva-personigais-uztura-plans-ikona.webp" alt="Atvērta grāmata ar atzīmētu sarakstu un auga zaru — Ievas Jēkabsones individuāli veidots uztura plāns, kas rakstīts vienam cilvēkam, ne šablonam" width="200" height="200" loading="lazy" />
          </span>
          <h3>Individuāls plāns</h3>
          <p>Tieši tavam ķermenim, ritmam un ikdienai. Ne vispārīga tabula. Ne PDF šablons.</p>
        </div>
        <div class="value-card">
          <span class="value-kicker">03</span>
          <span class="value-icon">
            <img src="/assets/images/ieva-uztura-veseligi-paradumi-lapas-ikona.webp" alt="Lapa ar izaugušu sakni — veselīgi ēšanas paradumi, kas turpina augt paši, arī tad, kad sadarbība ar uztura konsultanti ir beigusies" width="200" height="200" loading="lazy" />
          </span>
          <h3>Rīki neatkarībai</h3>
          <p>Lai ikdienas izvēles turpmāk izdarītu droši — bez mūžīgas atkarības no konsultanta.</p>
        </div>
        <div class="value-card">
          <span class="value-kicker">04</span>
          <span class="value-icon">
            <img src="/assets/images/ieva-uztura-sabalansets-skivis-ikona.webp" alt="Šķīvis ar lapām un labības vārpu — sabalansēta maltīte bez aizliegumiem, kurā vieta atrodas arī mīļākajiem ēdieniem" width="200" height="200" loading="lazy" />
          </span>
          <h3>Ēdiens vairs nav ienaidnieks</h3>
          <p>Bez vainas sajūtas pēc katras maltītes. Mīļākajiem ēdieniem atrodam vietu, ne aizliegumu.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 5 · GUIDE (Ieva) ═══ -->
  <section class="guide">
    <div class="wrap">
      <div class="guide-grid">

        <div style="position:relative;">
          <div class="guide-image frame photo" style="--obj: center 18%;">
            <img src="/assets/images/ieva-salad.webp" alt="Ieva Jēkabsone, ITEC sertificēta uztura konsultante, pie galda ar svaigiem salātiem" width="480" height="600" loading="lazy" />
          </div>
          <figure class="photo-stack">
            <img
              src="/assets/images/ieva-veseligas-brokastis-ogas-auzas-jogurts.webp"
              alt="Veselīgas brokastis — jogurts ar auzu pārslām, svaigām ogām un sēklām baltā keramikas bļodā"
              width="1024" height="1536" loading="lazy"
            />
          </figure>
          <span class="guide-sig">Ieva</span>
        </div>

        <div class="guide-body">
          <div class="eyebrow" style="margin-bottom:24px;">Tavs ceļvedis</div>

          <p class="pullquote">
            „Kad cilvēki atnāk pie manis, viņi bieži saka vienu un to pašu:
            <em>'man neviens vēl nav izskaidrojis, kāpēc.'</em>”
          </p>

          <p><strong>Es neiesaku diētas. Es iemācu ēst veselīgi.</strong></p>

          <p>
            Esmu Ieva Jēkabsone — uztura konsultante (nutriologs) ar ITEC sertifikātu. Savā darbā
            apvienoju uztura zinātni ar konkrētiem datiem par tavu ķermeni, lai saprastu
            ne tikai to, <em>ko ēst</em>, bet arī <em>kāpēc tev tas ir vajadzīgs</em>.
          </p>

          <p>
            Esmu strādājusi ar ļoti dažādiem cilvēkiem, un katram plāns izskatās citādi,
            jo tiek ņemtas vērā viņa individuālās vajadzības, nevis šablons.
            Manas zināšanas tev ir brīvi pieejamas — Uztura ABC sadaļā un blogā.
            Bet tavs personīgais plāns sākas ar tevi.
          </p>

          <div class="guide-credentials">
            <ul>
              <li><span class="tick">✓</span> ITEC sertificēta uztura konsultante</li>
              <li><span class="tick">✓</span> Vairāk nekā 50 klienti individuālajā darbā</li>
              <li><span class="tick">✓</span> Asinsanalīžu rādītāju izvērtēšana uztura un dzīvesveida kontekstā</li>
              <li><span class="tick">✓</span> C kategorijas fitnesa trenera sertifikāts</li>
            </ul>
            <p class="guide-note">
              Neesmu ārste. Diagnozes nenosaku, neārstēju un medikamentus nenozīmēju —
              strādāju ar uzturu un ikdienas paradumiem.
            </p>
          </div>

          <a href="/par-mani" class="btn btn-ghost" style="margin-top:32px;">Uzzini vairāk par mani <span class="arrow">→</span></a>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ 6 · PLAN ═══ -->
  <section class="plan">
    <div class="wrap">
      <div class="section-head" style="text-align:center; max-width:720px; margin-left:auto; margin-right:auto;">
        <div class="eyebrow center">Kā tas darbojas</div>
        <h2 class="section-title" style="margin-top:20px; color:var(--cream);">Trīs soļi līdz <em style="color:var(--gold);font-style:italic;">rezultātam.</em></h2>
      </div>

      <div class="plan-steps">

        <div class="plan-step">
          <div class="num">Solis 01</div>
          <span class="bicon-disc">
            <img src="/assets/images/ieva-uztura-personiga-saruna-ikona.webp" alt="Divi runas burbuļi ar auga lapu — sākuma konsultācija kā personīga saruna, ne pārdošanas zvans" width="200" height="200" loading="lazy" />
          </span>
          <h3>Sākuma konsultācija</h3>
          <p>Pastāsti savu situāciju. Es uzklausīšu, uzdošu jautājumus un kopā noskaidrosim, kā varu tev palīdzēt sasniegt mērķi.</p>
        </div>

        <div class="plan-step">
          <div class="num">Solis 02</div>
          <span class="bicon-disc">
            <img src="/assets/images/ieva-uztura-iepirkumu-saraksts-ikona.webp" alt="Iepirkumu saraksts ar atzīmētiem punktiem un burkānu — konkrētas ēdienkartes un iepirkumu saraksti tavam personīgajam plānam" width="200" height="200" loading="lazy" />
          </span>
          <h3>Tavs personīgais plāns</h3>
          <p>Individuāls plāns — tavam ķermenim, tavam ritmam, tavai ikdienai.</p>
        </div>

        <div class="plan-step">
          <div class="num">Solis 03</div>
          <span class="bicon-disc">
            <img src="/assets/images/ieva-uztura-ilgtermina-progress-ikona.webp" alt="Kāpnes ar augošu stiebru — pakāpenisks ilgtermiņa progress, kas paliek arī pēc sadarbības beigām" width="200" height="200" loading="lazy" />
          </span>
          <h3>Neatkarība</h3>
          <p>Iegūsti zināšanas un rīkus, lai šī būtu pēdējā „tievēšanas” reize — bez mūžīgiem konsultantiem un karuseļiem.</p>
        </div>

      </div>

      <div class="plan-cta">
        <a href="/pakalpojumi/sakuma-konsultacija" class="btn btn-primary">Pieteikt sākuma konsultāciju — 49 € <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═══ 7 · SERVICES ═══ -->
  <section class="services">
    <div class="wrap">
      <div class="section-head" style="max-width:720px;">
        <div class="eyebrow">Pakalpojumi</div>
        <h2 class="section-title" style="margin-top:20px;">Izvēlies savu <em>pirmo soli.</em></h2>
        <p class="lede" style="margin-top:20px;">
          Sāc ar konsultāciju, pēc tam izvēlies programmu, kas atbilst tavam mērķim.
        </p>
      </div>

      <div class="services-grid">

        <article class="service-card">
          <div class="service-label">01 · Skaidrība par nākamo soli</div>
          <h3>Sākuma konsultācija</h3>
          <div class="price">49 €</div>
          <ul>
            <li>Pārrunājam tavus mērķus, uzturu, dzīvesveidu un pašsajūtu</li>
            <li>Atbildu uz taviem jautājumiem par uzturu</li>
            <li>Pasaku godīgi, vai un kā varu palīdzēt</li>
            <li>Saņem skaidru nākamo soli, ko darīt jau tuvākajā nedēļā</li>
            <li>Der arī tad, ja gribi tikai vienu sarunu — programma nav obligāta</li>
            <li>49 € ieskaitu programmas cenā, ja to izvēlies 24 stundu laikā</li>
          </ul>
          <a href="/pakalpojumi/sakuma-konsultacija" class="btn btn-ghost">Uzzināt vairāk <span class="arrow">→</span></a>
        </article>

        <article class="service-card featured">
          <span class="service-tag">Ievas ieteiktā izvēle</span>
          <div class="service-label">02 · Tavs pirmais mēnesis</div>
          <h3>30 dienu programma</h3>
          <div class="price">249 € <small>/ 30 dienas</small></div>
          <ul>
            <li>3 konsultācijas: sākuma, plāna un noslēguma</li>
            <li>30 dienu ēdienkartes ar receptēm un porcijām</li>
            <li>Iepirkumu saraksti katrai nedēļai</li>
            <li>Asinsanalīžu rādītāju izvērtēšana uztura kontekstā</li>
            <li>Atbalsts rakstiski vai balss ziņā reizi nedēļā</li>
          </ul>
          <a href="/pakalpojumi/30-dienu-uztura-programma" class="btn btn-ghost">Uzzināt vairāk <span class="arrow">→</span></a>
        </article>

        <article class="service-card">
          <div class="service-label">03 · Paradums, kas noturas</div>
          <h3>90 dienu programma</h3>
          <div class="price">549 € <small>/ 90 dienas</small></div>
          <ul>
            <li>Trīs secīgi mēneši — katrs nākamais pielāgots tavam progresam</li>
            <li>5 konsultācijas un atbalsts visas 12 nedēļas</li>
            <li>Ēdienkartes, receptes un iepirkumu saraksti visam periodam</li>
            <li>Asinsanalīžu rādītāju izvērtēšana uztura kontekstā</li>
            <li>90 dienās izveido uztura kārtību, ko vari turpināt pats</li>
          </ul>
          <a href="/pakalpojumi/90-dienu-uztura-programma" class="btn btn-ghost">Uzzināt vairāk <span class="arrow">→</span></a>
        </article>

